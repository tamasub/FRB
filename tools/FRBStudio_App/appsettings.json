{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FrbStudio": {
    "DataFolders": [
      "data/json",
      "tests_screen_state",
      "test_results/diff"
    ],
    "CommandProfiles": {
      "GitDiffExport": {
        "Id": "git_diff_export",
        "DisplayName": "Export-DiffToJson.ps1 / Git Diff JSON Export",
        "ScriptPath": "tools/git/Export-DiffToJson.ps1",
        "OutputPath": "F:\\FRB\\tools\\FRBStudio_App\\wwwroot\\diff\\DiffToJson.json",
        "WorkingDirectory": "",
        "TimeoutSeconds": 30,
        "PowerShellExe": ""
      },
      "TestRunner": {
        "Id": "test_runner",
        "DisplayName": "TestRunner.ps1 / Studio Test Runner",
        "ScriptPath": "tools/test/TestRunner.ps1",
        "OutputPath": "",
        "WorkingDirectory": "",
        "TimeoutSeconds": 120,
        "PowerShellExe": ""
      }
    }
  }
}
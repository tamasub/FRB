                "visible": false
              },
              "edit": {
                "visible": false
              }
            },
            {
              "field": "bandA.b0",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": false
              }
            },
            {
              "field": "bandA.b1",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": false
              }
            },
            {
              "field": "bandA.b2",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": false
              }
            },
            {
              "field": "melodyHz",
              "caption": "Melody Hz",

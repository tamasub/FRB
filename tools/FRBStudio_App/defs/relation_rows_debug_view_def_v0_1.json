      "markdown": {
        "enabled": true,
        "type": "generic_sections",
        "title": "Relation → Diff 証跡カード",
        "defaultFileName": "relation_diff_cards_export.md",
        "sections": [
          {
            "title": "リレーション→Diff",
            "path": "$.relation_diff_cards",
            "format": "table",
            "fields": [
              "relation_id",
              "from_id",
              "relation",
              "to_id",
              "latest_result",
              "impact_label",
              "test_pattern_ids",
              "fail_count",
              "base_view_def"

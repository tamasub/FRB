{
  "app": {
    "name": "No-Code JSON Studio",
    "version": "0.3-draft-relation-diff-013"
  },
  "dataSources": {
    "relations": "constraint_trace_relations_v0_1.json",
    "diff": "screen_state_smoke_001.diff.json"
  },
  "virtualData": {
    "builder": "relation_diff_cards",
    "targetPath": "$.relation_diff_cards",
    "relations": {
      "source": "relations",
      "path": "$.relations"
    },
    "relation": {
      "testNodeType": "test_pattern",
      "checkType": "check",
      "containsCheckRelation": "contains_check"
    },
    "diff": {
      "source": "diff",
      "testNodeType": "test_pattern"
    },
    "diffViewDefs": {
      "base": {
        "view_def": "screen_state_diff_view_def_base_v0_2_checks.json",
        "caption": "【BASE】Screen State Diff Base View",
        "note": "diff JSON の共通表示定義。チェック一覧・期待値・実測値を持つ基底ビュー。"
      },
      "children": [
        {
          "view_def": "screen_state_diff_view_def_child_v0_3_summary.json",
          "caption": "【CHILD】Screen State Diff Summary View",
          "extends": "screen_state_diff_view_def_base_v0_2_checks.json",
          "note": "BASEを継承し、差分サマリ確認に寄せた子View。"
        },
        {
          "view_def": "screen_state_diff_view_def_child_v0_3_failure_focus.json",
          "caption": "【CHILD】Screen State Diff Failure Focus View",
          "extends": "screen_state_diff_view_def_base_v0_2_checks.json",
          "note": "BASEを継承し、失敗原因確認に寄せた子View。"
        }
      ]
    },
    "note": "Relation行を軸に、from/toから関連test_patternを推定し、最新diff・失敗チェック・BASE/CHILD diff ViewDef候補を保存せず一時生成する。"
  },
  "views": [
    {
      "id": "relation_diff_cards_view",
      "caption": "Relation → Diff 証跡カード / コネクト線 × 最新diff",
      "layout": {
        "detailDialog": "wide"
      },
      "sections": [
        {
          "id": "header",
          "caption": "Relation JSON / 基本情報",
          "type": "form",
          "dataPath": "$",
          "fields": [
            {
              "field": "title",
              "caption": "タイトル",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": false,
                "width": 260
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "schema_version",
              "caption": "Schema",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": false,
                "width": 120
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "document_type",
              "caption": "Document Type",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": false,
                "width": 180
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "policy",
              "caption": "設計方針",
              "type": "textarea",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true,
                "height": 76
              }
            },
            {
              "field": "source_note",
              "caption": "メモ",
              "type": "textarea",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true,
                "height": 70
              }
            }
          ]
        },
        {
          "id": "relation_diff_cards",
          "caption": "リレーション一覧 / Diff入口",
          "type": "grid",
          "dataPath": "$.relation_diff_cards",
          "keyField": "relation_id",
          "fields": [
            {
              "field": "relation_id",
              "caption": "Relation ID",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 220
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": true,

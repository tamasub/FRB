                "visible": false
              },
              "edit": {
                "visible": true,
                "subGrid": {
                  "columns": [
                    {
                      "field": "launch_action_type",
                      "caption": "処理の種類",
                      "type": "select",
                      "defaultValue": "Open",
                      "options": [
                        {
                          "value": "Open",
                          "label": "開く（ファイル・フォルダー・URL）"
                        },
                        {
                          "value": "SendKey",
                          "label": "文字列を入力"
                        },
                        {
                          "value": "ClipboardCopy",
                          "label": "クリップボードへコピー"
                        },
                        {
                          "value": "Run",
                          "label": "プログラム・スクリプトを実行"
                        }
                      ]
                    },
                    {
                      "field": "launch_target",
                      "caption": "開くファイル・フォルダー・URL",
                      "type": "text",
                      "defaultValue": "",
                      "visibleWhen": {
                        "field": "launch_action_type",
                        "in": [
                          "Open"
                        ]
                      },
                      "placeholder": "F:\\FRB_docsExcel\\実験全体図.xlsx",
                      "help": "ファイル・フォルダー・URL・shell: の対象を入力します。引用符は不要です。"
                    },
                    {
                      "field": "launch_text",
                      "caption": "送信する文字列",
                      "type": "textarea",
                      "defaultValue": "",
                      "visibleWhen": {
                        "field": "launch_action_type",
                        "in": [
                          "SendKey",
                          "ClipboardCopy"
                        ]
                      }
                    },
                    {
                      "field": "launch_program",
                      "caption": "実行プログラム",
                      "type": "text",
                      "defaultValue": "",
                      "visibleWhen": {
                        "field": "launch_action_type",
                        "in": [
                          "Run"
                        ]
                      }
                    },
                    {
                      "field": "launch_arguments",
                      "caption": "引数（1行に1つ）",
                      "type": "json",
                      "defaultValue": [],
                      "visibleWhen": {
                        "field": "launch_action_type",
                        "in": [
                          "Run"
                        ]
                      },
                      "control": "lines",
                      "help": "例: -NoProfile と -File は別々の行に入力します。JSON配列として保存します。"
                    },
                    {
                      "field": "launch_working_directory",
                      "caption": "作業フォルダー",
                      "type": "text",
                      "defaultValue": "",
                      "visibleWhen": {
                        "field": "launch_action_type",
                        "in": [
                          "Run"
                        ]
                      },
                      "advanced": true
                    },
                    {
                      "field": "launch_browser",
                      "caption": "ブラウザー（空欄は標準）",
                      "type": "select",
                      "defaultValue": "",
                      "options": [
                        "",
                        "chrome"
                      ],
                      "visibleWhen": {
                        "field": "launch_action_type",
                        "in": [
                          "Open"
                        ]
                      },
                      "advanced": true
                    },
                    {
                      "field": "launch_wait_for_exit",
                      "caption": "終了を待つ",

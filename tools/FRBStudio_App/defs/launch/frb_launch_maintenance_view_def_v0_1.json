            "createPresets": [
              {
                "caption": "カテゴリーを追加",
                "values": {
                  "item_kind": "category",
                  "icon_key": "category.blue"
                }
              },
              {
                "caption": "ファイルを開く",
                "values": {
                  "item_kind": "command",
                  "launch_actions": [
                    {
                      "launch_action_type": "Open",
                      "launch_target": ""
                    }
                  ]
                }
              },
              {
                "caption": "実行項目を追加",
                "values": {
                  "item_kind": "command"
                }
              },
              {
                "caption": "選択リストを追加",
                "values": {
                  "item_kind": "selection"
                }
              },
              {
                "caption": "フォルダー参照を追加",
                "values": {
                  "item_kind": "directory",
                  "icon_key": "folder"
                }
              }
            ],
            "groupRoots": true,
            "groupOrderField": "sort_order",
            "groupEnabledField": "enabled",
            "fileDrop": {
              "enabled": true,
              "fileTemplate": {
                "title": "{name}",
                "description": "{path}",
                "item_kind": "command",
                "icon_key": "file",
                "enabled": true,
                "launch_actions": [
                  {
                    "launch_action_type": "Open",
                    "launch_target": "{launchPath}"
                  }
                ]
              },
              "directoryTemplate": {
                "title": "{name}",
                "description": "{path}",
                "item_kind": "directory",
                "icon_key": "folder.yellow",
                "enabled": true,
                "launch_browse_target": "{launchPath}",
                "launch_actions": [
                  {
                    "launch_action_type": "Open",
                    "launch_target": "{launchPath}"
                  }
                ]
              }
            },
            "treeOnly": true,
            "dragMove": true,
            "captions": {
              "rootAdd": "Pageを追加",
              "rootEdit": "Pageを編集",
              "rootName": "Page名",
              "rootSelect": "Pageを選択してください",
              "rootMissing": "Page配列が見つかりません",
              "rootChoose": "追加先のPage",
              "rootToggle": "Pageを展開・折りたたみ"
            }

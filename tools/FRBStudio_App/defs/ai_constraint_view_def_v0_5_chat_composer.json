{
  "app": {
    "name": "No-Code JSON Studio",
    "version": "0.5-draft-chat-composer"
  },
  "views": [
    {
      "id": "ai_constraint_main",
      "caption": "AI制約設計書 Review Editor v0.5-verification-radio",
      "layout": "header-search-grid-detail",
      "sections": [
        {
          "id": "header",
          "caption": "制約設計書 基本情報 / 実施予定",
          "type": "form",
          "dataPath": "$",
          "fields": [
            {
              "field": "title",
              "caption": "タイトル",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": false
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "target",
              "caption": "対象",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "readonly": true
            },
            {
              "field": "schema_version",
              "caption": "Schema Version",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "readonly": true
            },
            {
              "field": "status",
              "caption": "状態",
              "type": "select",
              "options": [
                "human_review_draft",
                "reviewing",
                "approved",
                "needs_rework"
              ],
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true
              }
            },
            {
              "field": "generated_by",
              "caption": "生成者",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "readonly": true
            },
            {
              "field": "version_plan.current_version",
              "caption": "実施Version",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "readonly": true
            },
            {
              "field": "version_plan.status",
              "caption": "Version状態",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "readonly": true
            }
          ]
        },
        {
          "id": "constraints",
          "caption": "制約一覧",
          "type": "grid",
          "dataPath": "$.constraints",
          "keyField": "constraint_id",
          "fields": [
            {
              "field": "no",
              "caption": "No",
              "type": "number",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 60
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "constraint_id",
              "caption": "制約ID",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 110
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "category",
              "caption": "分類",
              "type": "select",
              "options": [
                "アプリ構成",
                "画面定義",
                "パス",
                "Field",
                "Grid表示",
                "編集",
                "検索",
                "ソート",
                "行操作",
                "コピー",
                "子配列",
                "保存",
                "Drop",
                "関連",
                "Markdown出力",
                "詳細ナビ",
                "承認",
                "未実装"
              ],
              "grid": {
                "visible": true,
                "width": 120
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "priority",
              "caption": "優先度",
              "type": "select",
              "options": [
                "high",
                "medium",
                "low"
              ],
              "grid": {
                "visible": true,
                "width": 90
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "title",
              "caption": "制約名",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 260
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "review_status",
              "caption": "AI状態",
              "type": "select",
              "options": [
                "",
                "waiting",
                "ai_answered",
                "needs_user_review",
                "closed"
              ],
              "grid": {
                "visible": true,
                "width": 130
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              },
              "defaultValue": "",
              "readonly": true
            },
            {
              "field": "action_status",
              "caption": "次の状態（AI記入）",
              "type": "select",
              "options": [
                "",
                "実施予定",
                "動作確認待ち",
                "AI回答待ち",
                "人間確認待ち",
                "完了",
                "保留"
              ],
              "grid": {
                "visible": true,
                "width": 130
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "readonly": true
            },
            {
              "field": "planned_version",
              "caption": "対応予定Version",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 150
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "readonly": true
            },
            {
              "field": "planned_item",
              "caption": "次やること",
              "type": "textarea",
              "grid": {
                "visible": true,
                "width": 260
              },
              "edit": {
                "visible": true,
                "height": 90
              }
            },
            {
              "field": "review_check",
              "caption": "承認",
              "type": "select",
              "options": [
                "未確認",
                "◎正しい",
                "△半分正しい",
                "×違う",
                "★足りない"
              ],
              "grid": {
                "visible": true,
                "width": 120
              },
              "edit": {
                "visible": false,
                "control": "radio",
                "shortcut": "F12で反映"
              },
              "search": {
                "visible": true,
                "operator": "equals"
              },
              "defaultValue": "未確認",
              "placement": "embedded_in_user_comment",
              "embeddedIn": "user_comment"
            },
            {
              "field": "__review_chat",
              "caption": "制約レビュー会話",
              "type": "chat",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "messages": [
                  {
                    "role": "constraint",
                    "field": "statement",
                    "label": "制約本文",
                    "readonly": true,
                    "height": 90
                  },
                  {
                    "role": "user",
                    "field": "user_comment",
                    "label": "俺コメント",
                    "height": 110,
                    "embeddedFields": [
                      {
                        "field": "review_check",
                        "label": "",
                        "type": "select",
                        "control": "radio",
                        "display": "inline",
                        "shortcut": "F12で反映",
                        "options": [
                          "未確認",
                          "◎正しい",
                          "△半分正しい",
                          "×違う",
                          "★足りない"
                        ]
                      }
                    ]
                  },
                  {
                    "role": "ai",
                    "field": "ai_response",
                    "label": "AI回答",
                    "readonly": true,
                    "height": 110
                  },
                  {
                    "role": "user",
                    "field": "user_reply",
                    "label": "俺追加回答",
                    "height": 90
                  },
                  {
                    "role": "ai",
                    "field": "ai_followup_response",
                    "label": "AI再回答",
                    "readonly": true,
                    "height": 110
                  }
                ],
                "input": {
                  "enabled": true,
                  "placeholder": "この制約へのコメントを追加...",
                  "userField": "user_reply",
                  "aiField": "ai_followup_response",
                  "sendLabel": "送信"
                }
              },
              "search": {
                "visible": false
              },
              "create": {
                "include": false
              },
              "chat_layout_note": "空の俺追加回答/AI再回答は通常非表示。下部入力バーからコメント送信すると user_reply に追加し、AI再回答欄を空で表示する。"
            },
            {
              "field": "statement",
              "caption": "制約本文",
              "type": "textarea",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": false,
                "height": 100
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "ai_response",
              "caption": "AI回答",
              "type": "textarea",
              "grid": {
                "visible": true,
                "width": 320
              },
              "edit": {
                "visible": false,
                "readonly": true,
                "height": 130
              },
              "readonly": true,
              "search": {
                "visible": true,
                "operator": "contains"
              },
              "defaultValue": ""
            },
            {
              "field": "user_comment",
              "caption": "俺コメント",
              "type": "textarea",
              "grid": {
                "visible": true,
                "width": 280
              },
              "edit": {
                "visible": false,
                "height": 110
              },
              "search": {
                "visible": true,
                "operator": "contains"
              },
              "defaultValue": ""
            },
            {
              "field": "user_reply",
              "caption": "俺追加回答",
              "type": "textarea",
              "grid": {
                "visible": true,
                "width": 280
              },
              "edit": {
                "visible": false,
                "height": 110
              },
              "search": {
                "visible": true,
                "operator": "contains"
              },
              "defaultValue": ""
            },
            {
              "field": "ai_followup_response",
              "caption": "AI再回答",
              "type": "textarea",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": false,
                "readonly": true,
                "height": 120
              },
              "search": {
                "visible": true,
                "operator": "contains"
              },
              "readonly": true,
              "defaultValue": ""
            },
            {
              "field": "evidence",
              "caption": "根拠",
              "type": "textarea",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "height": 80
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "source_type",
              "caption": "由来（AI記入）",
              "type": "select",
              "options": [
                "実装由来",
                "思想由来",
                "追加制約",
                "GAP"
              ],
              "grid": {
                "visible": true,
                "width": 110
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              },
              "readonly": true
            },
            {
              "field": "ai_note",
              "caption": "AI初期メモ",
              "type": "textarea",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true,
                "height": 70
              },
              "search": {
                "visible": false
              },
              "readonly": true
            },
            {
              "field": "verified_version",
              "caption": "確認対象Version",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 140
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              },
              "defaultValue": "v0.3-draft"
            },
            {
              "field": "verification_status",
              "caption": "動作確認",
              "type": "select",
              "options": [
                "未確認",
                "確認済み",
                "対象外"
              ],
              "grid": {
                "visible": true,
                "width": 110
              },
              "edit": {
                "visible": true,
                "control": "radio"
              },
              "search": {
                "visible": true,
                "operator": "equals"
              },
              "defaultValue": "未確認"
            },
            {
              "field": "implemented",
              "caption": "実装済（旧項目・非表示）",
              "type": "boolean",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": false
              },
              "search": {
                "visible": false
              },
              "defaultValue": false,
              "legacy_note": "verification_status / verified_version へ移行"
            },
            {
              "field": "gap_type",
              "caption": "Gap（旧項目・非表示）",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": false
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "decision",
              "caption": "判断（旧項目・非表示）",
              "type": "select",
              "options": [
                "",
                "採用",
                "保留",
                "却下",
                "統合",
                "別制約へ分離"
              ],
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": false
              },
              "search": {
                "visible": true,
                "operator": "equals"
              },
              "defaultValue": ""
            }
          ]
        }
      ]
    }
  ]
}
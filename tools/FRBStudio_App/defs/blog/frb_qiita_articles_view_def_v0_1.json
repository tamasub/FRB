{
  "$schema": "frb_view_def_schema_v0_9.json",
  "app": {
    "name": "FRB Studio / JSON Object Studio",
    "version": "v0.18.138-frb-qiita-articles-viewdef"
  },
  "views": [
    {
      "id": "frb_qiita_articles",
      "caption": "FRB Qiita記事アーカイブ",
      "layout": {
        "detailDialog": "wide"
      },
      "sections": [
        {
          "id": "header",
          "caption": "基本情報",
          "type": "form",
          "dataPath": "$",
          "fields": [
            {
              "field": "title",
              "caption": "タイトル",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": false,
                "readonly": true
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "source",
              "caption": "取得元",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "article_count",
              "caption": "記事件数",
              "type": "number",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "generated_at",
              "caption": "生成日時",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": false
              }
            }
          ]
        },
        {
          "id": "articles",
          "caption": "記事一覧",
          "type": "grid",
          "dataPath": "$.articles",
          "keyField": "article_id",
          "fields": [
            {
              "field": "title",
              "caption": "タイトル",
              "type": "text",
              "width": 666,
              "grid": {
                "visible": true
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": true
              }
            },
            {
              "field": "created_at",
              "caption": "公開日",
              "type": "datetime",
              "width": 190,
              "grid": {
                "visible": true
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "tags",
              "caption": "タグ",
              "type": "stringArray",
              "width": 260,
              "grid": {
                "visible": true
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "url",
              "caption": "URL",
              "type": "text",
              "width": 260,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "article_id",
              "caption": "Article ID",
              "type": "text",
              "width": 160,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "source_file",
              "caption": "ソースMdファイル",
              "type": "text",
              "width": 300,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "body",
              "caption": "本文",
              "type": "textarea",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true,
                "height": 420
              },
              "search": {
                "visible": true,
                "operator": "contains"
              },
              "markdown": {
                "enabled": true,
                "allowLinks": true,
                "allowImages": true
              },
              "display_note": "Qiita記事本文(Markdown原文)。詳細画面でMarkdownリンク/画像記法を許可する想定。",
              "width": "FULL"
            }
          ]
        }
      ]
    }
  ]
}

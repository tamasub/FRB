{
  "app": {
    "name": "FRB Studio / JSON Object Studio",
    "version": "0.2-draft"
  },
  "views": [
    {
      "id": "experiment_profile_editor_v0_1",
      "caption": "実験条件プロファイル",
      "layout": "header-search-grid-detail",
      "sections": [
        {
          "id": "items",
          "caption": "実験条件一覧",
          "type": "grid",
          "dataPath": "$.items",
          "keyField": "profile_id",
          "fields": [
            {
              "field": "profile_id",
              "caption": "Profile ID",
              "type": "text",
              "grid": { "visible": true, "width": 180 },
              "edit": { "visible": true, "readonly": false },
              "search": { "visible": true, "operator": "contains" }
            },
            {
              "field": "name",
              "caption": "名称",
              "type": "text",
              "grid": { "visible": true, "width": 160 },
              "edit": { "visible": true, "readonly": false },
              "search": { "visible": true, "operator": "contains" }
            },
            {
              "field": "input_type",
              "caption": "入力方式",
              "type": "select",
              "options": ["speaker_sweep", "manual_rub", "impulse", "bite_simulator"],
              "grid": { "visible": true, "width": 160 },
              "edit": { "visible": true, "readonly": false },
              "search": { "visible": true, "operator": "equals" }
            },
            {
              "field": "target",
              "caption": "対象",
              "type": "text",
              "grid": { "visible": true, "width": 180 },
              "edit": { "visible": true, "readonly": false },
              "search": { "visible": true, "operator": "contains" }
            },
            {
              "field": "notes",
              "caption": "メモ",
              "type": "textarea",
              "grid": { "visible": true, "width": 360 },
              "edit": { "visible": true, "readonly": false, "height": 80 },
              "search": { "visible": true, "operator": "contains" }
            },
            {
              "field": "sweep_settings",
              "caption": "スイープ設定",
              "type": "objectArray",
              "readonly": false,
              "grid": { "visible": false },
              "edit": { "visible": true, "readonly": false },
              "childFields": [
                { "field": "duration_sec", "caption": "秒数", "type": "number", "defaultValue": 30 },
                { "field": "freq_start_hz", "caption": "開始Hz", "type": "number", "defaultValue": 20 },
                { "field": "freq_end_hz", "caption": "終了Hz", "type": "number", "defaultValue": 300 }
              ],
              "defaultValue": [
                { "duration_sec": 30, "freq_start_hz": 20, "freq_end_hz": 300 }
              ]
            }
          ]
        }
      ]
    }
  ]
}

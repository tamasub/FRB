{
  "extends": "fft_log_view_def_v0_2.json",
  "app": {
    "name": "No-Code JSON Studio",
    "version": "0.3-draft / extends-demo-phase2"
  },
  "views": [
    {
      "id": "fft_log_main",
      "caption": "FFT Log Viewer / Phase2 Focus（差分View）",
      "sections": [
        {
          "id": "header",
          "caption": "FFTログ情報（Phase2 Focus）"
        },
        {
          "id": "tsBuf",
          "caption": "Phase2 / Attack 視点 tsBuf",
          "fields": [
            {
              "field": "t",
              "caption": "Time",
              "grid": {
                "width": 90,
                "format": "#.000"
              },
              "format": "#.000"
            },
            {
              "field": "phase2State",
              "caption": "Phase2状態",
              "grid": {
                "visible": true,
                "width": 120
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "attackState",
              "caption": "Attack状態",
              "grid": {
                "visible": true,
                "width": 115
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "peakAHz",
              "caption": "Peak Hz",
              "grid": {
                "visible": true,
                "width": 95,
                "format": "#.000"
              }
            },
            {
              "field": "inputHz",
              "grid": {
                "visible": false
              },
              "search": {
                "visible": false
              },
              "edit": {
                "visible": false
              }
            },
            {
              "field": "melodyNote",
              "grid": {
                "visible": false
              },
              "search": {
                "visible": false
              },
              "edit": {
                "visible": false
              }
            },
            {
              "field": "bandA.b0",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": false
              }
            },
            {
              "field": "bandA.b1",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": false
              }
            },
            {
              "field": "bandA.b2",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": false
              }
            },
            {
              "field": "attackScore",
              "caption": "Attack Score",
              "type": "number",
              "grid": {
                "visible": true,
                "width": 120,
                "format": "#.000000"
              },
              "edit": {
                "visible": true,
                "readonly": false,
                "step": "0.000001"
              },
              "search": {
                "visible": true,
                "operator": "gte"
              },
              "format": "#.000000",
              "defaultValue": 0
            },
            {
              "field": "tingleMotion",
              "caption": "Tingle Motion",
              "type": "number",
              "grid": {
                "visible": true,
                "width": 125,
                "format": "#.000000"
              },
              "edit": {
                "visible": true,
                "readonly": false,
                "step": "0.000001"
              },
              "search": {
                "visible": true,
                "operator": "gte"
              },
              "format": "#.000000",
              "defaultValue": 0
            },
            {
              "field": "contactClass",
              "caption": "接触分類",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 110
              },
              "edit": {
                "visible": true,
                "readonly": false
              },
              "search": {
                "visible": true,
                "operator": "contains"
              },
              "defaultValue": ""
            },
            {
              "field": "classReason",
              "caption": "分類理由",
              "type": "textarea",
              "grid": {
                "visible": true,
                "width": 240
              },
              "edit": {
                "visible": true,
                "readonly": false,
                "height": 70
              },
              "search": {
                "visible": true,
                "operator": "contains"
              },
              "defaultValue": ""
            }
          ]
        }

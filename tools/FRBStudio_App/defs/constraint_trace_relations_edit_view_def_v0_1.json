{
  "app": {
    "name": "No-Code JSON Studio",
    "version": "0.3-draft-relation-edit-010"
  },
  "views": [
    {
      "id": "constraint_trace_relations_edit",
      "caption": "制約証跡リレーション編集 / コネクト線定義",
      "layout": {
        "detailDialog": "wide"
      },
      "sections": [
        {
          "id": "header",
          "caption": "Relation JSON / 基本情報",
          "type": "form",
          "dataPath": "$",
          "fields": [
            {
              "field": "title",
              "caption": "タイトル",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "schema_version",
              "caption": "Schema",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "policy",
              "caption": "設計方針",
              "type": "textarea",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true,
                "height": 86
              }
            }
          ]
        },
        {
          "id": "relations",
          "caption": "コネクト線一覧 / 人間承認対象",
          "type": "grid",
          "dataPath": "$.relations",
          "keyField": "relation_id",
          "fields": [
            {
              "field": "relation_id",
              "caption": "Relation ID",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 210
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "from_type",
              "caption": "From Type",
              "type": "select",
              "options": [
                "constraint",
                "test_pattern",
                "check",
                "expected_state",
                "diff",
                "test_run"
              ],
              "grid": {
                "visible": true,
                "width": 120
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "from_id",
              "caption": "From ID",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 170
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "relation",
              "caption": "Relation",
              "type": "select",
              "options": [
                "verified_by",
                "contains_check",
                "expects",
                "produced_diff",
                "failed_check",
                "may_violate"
              ],
              "grid": {
                "visible": true,
                "width": 140
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "to_type",
              "caption": "To Type",
              "type": "select",
              "options": [
                "constraint",
                "test_pattern",
                "check",
                "expected_state",
                "diff",
                "test_run"
              ],
              "grid": {
                "visible": true,
                "width": 120
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "to_id",
              "caption": "To ID",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 180
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "status",
              "caption": "承認状態",
              "type": "select",
              "options": [
                "candidate",
                "approved",
                "rejected",
                "derived",
                "deprecated"
              ],
              "grid": {
                "visible": true,
                "width": 110
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "coverage",
              "caption": "Coverage",
              "type": "select",
              "options": [
                "primary",
                "secondary",
                "structure",
                "manual",
                "regression"
              ],
              "grid": {
                "visible": true,
                "width": 110
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "confidence",
              "caption": "Confidence",
              "type": "select",
              "options": [
                "high",
                "medium",
                "low",
                "unknown"
              ],
              "grid": {
                "visible": true,
                "width": 110
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "required",
              "caption": "Required",
              "type": "boolean",
              "grid": {
                "visible": true,
                "width": 90
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "enabled",
              "caption": "Enabled",
              "type": "boolean",
              "grid": {
                "visible": true,
                "width": 90
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "priority",
              "caption": "Priority",
              "type": "select",
              "options": [
                "high",
                "medium",
                "low"
              ],
              "grid": {
                "visible": true,
                "width": 90
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "note",
              "caption": "メモ",
              "type": "textarea",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "height": 92
              }
            }
          ]
        }
      ],
      "markdown": {
        "enabled": true,
        "type": "generic_sections",
        "title": "制約証跡リレーション",
        "defaultFileName": "constraint_trace_relations_report.md",
        "sections": [
          {
            "title": "コネクト線一覧",
            "dataPath": "$.relations",
            "format": "table",
            "fields": [
              "relation_id",
              "from_type",
              "from_id",
              "relation",
              "to_type",
              "to_id",
              "status",
              "coverage",
              "confidence"
            ]
          }
        ]
      }
    }
  ]
}
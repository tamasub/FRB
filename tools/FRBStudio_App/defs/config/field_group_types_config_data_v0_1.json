{
  "schema_version": "field_group_types_config_data_v0_1",
  "document_type": "field_group_type_config",
  "title": "FieldGroupType Config / ViewDef動的拡張設定",
  "phase": "v0.18.14-fieldgroup-type-dynamic-switch-expecteddef-viewdef",
  "purpose": "ViewDef本体を太らせず、意味のある複数FieldのまとまりをFieldGroupTypeとして定義・再利用する。ExpectedDefはFieldGroupTypeの初期実装として扱う。",
  "policy": {
    "core_concept": "FieldGroupTypeはViewDefのプラグインポイント。Rendererは個別ExpectedDefの詳細を知らず、Resolverが通常fieldsへ展開してから既存Rendererへ渡す。",
    "static_usage": "ViewDef側で fieldGroupType を直接指定すると、指定されたFieldGroupTypeを静的に展開する。",
    "dynamic_usage": "ViewDef側で動的FieldGroupTypeを指定すると、Data行のexpected_def_type等を見て、表示対象FieldGroupTypeを切り替える。",
    "config_location": "defs/config はStudio Coreの拡張設定置き場。業務データではなく、ViewDef拡張設定として管理する。"
  },
  "namespaces": {
    "studio": {
      "fieldGroups": {
        "ExpectedDef": {
          "caption": "ExpectedDef 動的FieldGroup",
          "description": "test_patterns[] の expected_def_type を見て、期待値表示フィールドを切り替えるFieldGroupType。",
          "dynamic": {
            "sourceField": "expected_def_type",
            "defaultFieldGroupType": "studio.RuleExpectedDef",
            "map": {

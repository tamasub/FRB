{
  "app": {
    "name": "No-Code JSON Studio",
    "version": "0.3-draft-relation-test-axis-011"
  },
  "dataSources": {
    "constraints": "ai_constraint_spec_aggregated_v0_6_footer_chat.json",
    "tests": "screen_state_test_patterns_data_v0_2_chat.json",
    "diff": "screen_state_smoke_001.diff.json",
    "relations": "constraint_trace_relations_v0_1.json"
  },
  "virtualData": {
    "builder": "test_pattern_trace_cards",
    "targetPath": "$.test_pattern_trace_cards",
    "relationsPath": "$.relations",
    "note": "relations JSON + テストパターンJSON + 最新diff JSONから、テストパターン軸の表示カードを保存せずに一時生成する。"
  },
  "views": [
    {
      "id": "test_pattern_trace_cards_view",
      "caption": "テストパターン証跡カード / Relation JSON × 最新diff",
      "layout": {
        "detailDialog": "wide"
      },
      "sections": [
        {
          "id": "header",
          "caption": "Relation JSON / 基本情報",
          "type": "form",
          "dataPath": "$",
          "fields": [
            {
              "field": "title",
              "caption": "タイトル",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "schema_version",
              "caption": "Schema",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "document_type",
              "caption": "Document Type",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "policy",
              "caption": "設計方針",
              "type": "textarea",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true,
                "height": 76
              }
            },
            {
              "field": "source_note",
              "caption": "メモ",
              "type": "textarea",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true,
                "height": 70
              }
            }
          ]
        },
        {
          "id": "test_pattern_trace_cards",
          "caption": "テストパターン一覧 / 証拠保管庫入口",
          "type": "grid",
          "dataPath": "$.test_pattern_trace_cards",
          "keyField": "test_pattern_id",
          "fields": [
            {
              "field": "test_pattern_id",
              "caption": "テストID",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 190
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "test_pattern_title",
              "caption": "テスト名",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 280
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "category",
              "caption": "分類",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 100
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "test_kind",
              "caption": "種別",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 120
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "trace_label",
              "caption": "証跡状態",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 140
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "latest_result",
              "caption": "最新結果",
              "type": "select",
              "options": [
                "fail",
                "pass",
                "executed",
                "unverified"
              ],
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 90
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "linked_constraints_count",

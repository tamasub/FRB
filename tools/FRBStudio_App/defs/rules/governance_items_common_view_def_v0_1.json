{
  "app": {
    "name": "FRB Studio / JSON Object Studio",
    "version": "governance-items-common-v0.1"
  },
  "views": [
    {
      "id": "governance_items_common_v0_1",
      "caption": "判断軸・制約",
      "layout": {
        "detailDialog": "wide"
      },
      "sections": [
        {
          "id": "governance_items",
          "caption": "判断軸・制約",
          "type": "grid",
          "dataPath": "$.governance_items",
          "keyField": "item_id",
          "fields": [
            {
              "field": "sort_order",
              "caption": "順",
              "type": "number",
              "defaultValue": 10,
              "grid": {
                "visible": true,
                "width": 60
              },
              "edit": {
                "visible": true
              }
            },
            {
              "field": "item_id",
              "caption": "判断資産ID",
              "type": "text",
              "defaultValue": "",
              "grid": {
                "visible": true,
                "width": 210
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "item_type",
              "caption": "種別",
              "type": "select",
              "options": [
                "DECISION_AXIS",
                "CONSTRAINT"
              ],
              "defaultValue": "DECISION_AXIS",
              "grid": {
                "visible": true,
                "width": 150
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "title",
              "caption": "タイトル",
              "type": "text",
              "defaultValue": "",
              "grid": {
                "visible": true,
                "width": 280
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "statement",
              "caption": "内容",
              "type": "textarea",
              "defaultValue": "",
              "grid": {
                "visible": true,
                "width": 620
              },
              "edit": {
                "visible": true,
                "height": 120
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "reason",
              "caption": "昇格理由・背景",
              "type": "textarea",
              "defaultValue": "",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "height": 120
              },
              "search": {
                "visible": false,
                "operator": "contains"
              }
            },
            {
              "field": "scope",
              "caption": "適用範囲",
              "type": "text",
              "defaultValue": "document",
              "grid": {
                "visible": true,
                "width": 130
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "priority",
              "caption": "優先度",
              "type": "select",
              "options": [
                "high",
                "medium",
                "low"
              ],
              "defaultValue": "medium",
              "grid": {
                "visible": true,
                "width": 100
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "status",
              "caption": "状態",
              "type": "select",
              "options": [
                "DRAFT",
                "ACTIVE",
                "DEPRECATED"
              ],
              "defaultValue": "DRAFT",
              "grid": {
                "visible": true,
                "width": 110
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "evaluation_guidance",
              "caption": "判断軸の評価ガイド",
              "type": "textarea",
              "defaultValue": "",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "height": 100
              }
            },
            {
              "field": "verification_method",
              "caption": "制約の確認方法",
              "type": "textarea",
              "defaultValue": "",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "height": 100
              }
            },
            {
              "field": "violation_action",
              "caption": "制約違反時の扱い",
              "type": "textarea",
              "defaultValue": "",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "height": 100
              }
            },
            {
              "field": "source_decision_log_ids",
              "caption": "昇格元判断ログID",
              "type": "stringArray",
              "defaultValue": [],
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true
              },
              "display_note": "制約・判断軸を新規作成した根拠となる判断ログIDを記録する。"
            },
            {
              "field": "notes",
              "caption": "メモ",
              "type": "textarea",
              "defaultValue": "",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "height": 90
              }
            }
          ]
        }
      ],
      "layout_note": "v0.18.28: 判断軸・制約という業務語をRuntimeへ固定せず、Data rootのgovernance_items配列を編集する初回サンプルViewDef。item_typeでDECISION_AXIS / CONSTRAINTを区別する。"
    }
  ],
  "layout_note": "汎用別Grid起動機能の初回利用例。別Grid起動Runtimeはこのファイル名やgovernance_itemsを固定判定しない。",
  "currentDataDisplay": {
    "titlePath": "$.title",
    "subtitlePath": "$.target",
    "showDataPath": true
  }
}

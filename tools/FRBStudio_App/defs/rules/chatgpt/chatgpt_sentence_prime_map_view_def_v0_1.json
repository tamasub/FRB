{
  "app": {
    "name": "Sentence Prime Map Viewer",
    "version": "v0.1"
  },
  "views": [
    {
      "id": "sentences",
      "caption": "センテンス一覧",
      "layout": {
        "detailDialog": "wide"
      },
      "sections": [
        {
          "id": "meta",
          "caption": "メタ",
          "type": "form",
          "dataPath": "$.meta",
          "fields": [
            {
              "field": "title",
              "caption": "Title",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true
              }
            },
            {
              "field": "purpose",
              "caption": "Purpose",
              "type": "textarea",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": false,
                "height": 80
              }
            },
            {
              "field": "concept",
              "caption": "Concept",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true
              }
            },
            {
              "field": "expected_win_condition",
              "caption": "勝ち条件",
              "type": "textarea",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": false,
                "height": 80
              }

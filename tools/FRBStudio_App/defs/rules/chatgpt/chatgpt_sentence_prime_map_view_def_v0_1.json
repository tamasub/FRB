            {
              "field": "warning",
              "caption": "Warning",
              "type": "textarea",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": false,
                "height": 80
              }
            }
          ]
        },
        {
          "id": "sentences",
          "caption": "センテンス",
          "type": "grid",
          "dataPath": "$.sentences",
          "keyField": "sentence_id",
          "fields": [
            {
              "field": "sentence_id",
              "caption": "Sentence ID",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 95
              },
              "edit": {
                "visible": true
              }
            },
            {
              "field": "source_section",
              "caption": "Source Section",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 220
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "primary_anchor",
              "caption": "Primary Anchor",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 150
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "source_sentence",
              "caption": "Source Sentence",
              "type": "textarea",
              "grid": {
                "visible": true,
                "width": 620
              },
              "edit": {
                "visible": true,
                "height": 130
              }
            },
            {
              "field": "sentence_note",
              "caption": "Sentence Note",
              "type": "textarea",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "height": 90

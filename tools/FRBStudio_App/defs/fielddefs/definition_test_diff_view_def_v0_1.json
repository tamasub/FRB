{
  "$schema": "frb_view_def_schema_v0_9.json",
  "view_def": "fielddefs/definition_test_diff_view_def_v0_1.json",
  "app": {
    "name": "FRB Studio / JSON Object Studio",
    "version": "definition-test-diff-review-v0.1"
  },
  "description": "Definition Test Runnerが出力するdiff_result_v0_1を、人間がExecution Evidenceと実行時Field Definition Snapshotを同一Detailで確認するためのViewDef。",
  "currentDataDisplay": {
    "titlePath": "$.title",
    "subtitlePath": "$.test_id",
    "showDataPath": true,
    "note": "Diff Detailでは実行値・Expected・Actualを正本Evidenceとして表示し、右側には同じDefinition Componentを使って実行時SnapshotのConstraint Resolution / TestPatternを表示する。"
  },
  "views": [
    {
      "id": "definition_test_diff_review_v0_1",
      "caption": "Definition Test Diff / Evidence Review",
      "layout": {
        "detailDialog": "wide"
      },
      "sections": [
        {
          "id": "summary",
          "caption": "Definition Test Diff Summary",
          "type": "form",
          "dataPath": "$",
          "fields": [
            {
              "field": "resultLabel",
              "caption": "判定",
              "type": "text",
              "readonly": true,
              "grid": { "visible": false },
              "edit": { "visible": true, "readonly": true }
            },
            {
              "field": "summary",
              "caption": "サマリ",
              "type": "textarea",
              "readonly": true,
              "grid": { "visible": false },
              "edit": { "visible": true, "readonly": true, "height": 80 }
            },
            {
              "field": "test_id",
              "caption": "Test ID",
              "type": "text",
              "readonly": true,
              "grid": { "visible": false },
              "edit": { "visible": true, "readonly": true }
            },
            {
              "field": "generated_at",
              "caption": "Generated At",
              "type": "text",
              "readonly": true,
              "grid": { "visible": false },
              "edit": { "visible": true, "readonly": true }
            },
            {
              "field": "total",
              "caption": "Total",
              "type": "number",
              "readonly": true,
              "grid": { "visible": false },
              "edit": { "visible": true, "readonly": true }
            },
            {
              "field": "failedCount",
              "caption": "Failed",
              "type": "number",
              "readonly": true,
              "grid": { "visible": false },
              "edit": { "visible": true, "readonly": true }
            }
          ]
        },
        {
          "id": "checks",
          "caption": "Definition Test Checks",
          "type": "grid",
          "dataPath": "$.checks",
          "keyField": "check_id",
          "fields": [
            {
              "field": "result",
              "caption": "Result",
              "type": "text",
              "readonly": true,
              "grid": { "visible": true, "width": 80 },
              "edit": { "visible": true, "readonly": true }
            },
            {
              "field": "name",
              "caption": "Test Pattern",
              "type": "text",
              "readonly": true,
              "grid": { "visible": true, "width": 190 },
              "edit": { "visible": true, "readonly": true }
            },
            {
              "field": "target",
              "caption": "Field / Target",
              "type": "text",
              "readonly": true,
              "grid": { "visible": true, "width": 300 },
              "edit": { "visible": true, "readonly": true }
            },
            {
              "field": "input",
              "caption": "Input",
              "type": "textarea",
              "readonly": true,
              "grid": { "visible": true, "width": 250, "display": "json", "inlineJson": true },
              "edit": { "visible": true, "readonly": true, "height": 110 }
            },
            {
              "field": "expected",
              "caption": "Expected",
              "type": "text",
              "readonly": true,
              "grid": { "visible": true, "width": 100 },
              "edit": { "visible": true, "readonly": true }
            },
            {
              "field": "actual",
              "caption": "Actual",
              "type": "text",
              "readonly": true,
              "grid": { "visible": true, "width": 100 },
              "edit": { "visible": true, "readonly": true }
            },
            {
              "field": "expected_reason_code",
              "caption": "Expected Reason",
              "type": "text",
              "readonly": true,
              "grid": { "visible": false },
              "edit": { "visible": true, "readonly": true }
            },
            {
              "field": "actual_reason_code",
              "caption": "Actual Reason",
              "type": "text",
              "readonly": true,
              "grid": { "visible": false },
              "edit": { "visible": true, "readonly": true }
            },
            {
              "field": "comparison_reason_code",
              "caption": "Comparison",
              "type": "text",
              "readonly": true,
              "grid": { "visible": false },
              "edit": { "visible": true, "readonly": true }
            },
            {
              "field": "validation_type_id",
              "caption": "Validation Type",
              "type": "text",
              "readonly": true,
              "grid": { "visible": false },
              "edit": { "visible": true, "readonly": true }
            },
            {
              "field": "constraint_ref",
              "caption": "Constraint Source",
              "type": "text",
              "readonly": true,
              "grid": { "visible": false },
              "edit": { "visible": true, "readonly": true }
            },
            {
              "field": "check_id",
              "caption": "Check ID",
              "type": "text",
              "readonly": true,
              "grid": { "visible": false },
              "edit": { "visible": true, "readonly": true }
            },
            {
              "field": "pattern_id",
              "caption": "Pattern ID",
              "type": "text",
              "readonly": true,
              "grid": { "visible": false },
              "edit": { "visible": true, "readonly": true }
            },
            {
              "field": "message",
              "caption": "Diff Message",
              "type": "textarea",
              "readonly": true,
              "grid": { "visible": false },
              "edit": { "visible": true, "readonly": true, "height": 70 }
            }
          ],
          "editorComponents": [
            {
              "id": "definition_evidence_review",
              "type": "definition_evidence_review",
              "placement": "detailBody",
              "caption": "Linked Field Definition / Execution Evidence",
              "readonly": true,
              "config": {
                "targetViewDefPath": "frb/frb_fft_field_definition_sample_view_def_v0_1.json"
              }
            }
          ]
        }
      ]
    }
  ]
}

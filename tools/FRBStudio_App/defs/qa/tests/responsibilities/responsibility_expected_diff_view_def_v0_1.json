            {
              "id": "responsibility_diff_result_preview",
              "type": "responsibility_diff_result_preview",
              "placement": "afterChildGrids",
              "caption": "TestPattern / Result Evidence Preview",
              "readonly": true,
              "config": {
                "showRawJson": true,
                "notes": "一覧はTestPattern単位の量的サマリに留め、Editorでは保存済みDiff Evidenceだけを使ってExpected / Actual / Diff / 観測根拠を事実ベースで表示する。"

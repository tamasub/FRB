{
  "$schema": "frb_view_def_schema_v0_9.json",
  "view_def": "qa/tests/responsibilities/responsibility_expected_diff_view_def_v0_1.json",
  "app": {
    "name": "FRBStudio",
    "version": "responsibility_expected_diff_view_def_v0_3-testpattern-summary"
  },
  "description": "Responsibility単位Diff Evidenceを確認するViewDef。保存Evidenceはchecks[]でCheck粒度を維持し、一覧はtest_pattern_results[]でTestPattern単位へ圧縮する。EditorではExpected / Actual / Diff / 観測Evidenceを事実ベースで表示する。",

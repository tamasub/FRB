{
  "$schema": "frb_view_def_schema_v0_9_chat_input_mapping.json",
  "view_def": "qa/qa_diff_result_view_def_v0_1.json",
  "app": {
    "name": "FRBStudio",
    "version": "qa_diff_result_view_def_v0_1"
  },
  "description": "QA Diff Result JSON を Studioくんで確認するための暫定ViewDef。diff.jsonはexpected/actual/pass/summaryを持つ。",
  "views": [
    {
      "id": "qa_diff_result",
      "caption": "QA Diff Result / Expected vs Actual",
      "layout": "header-search-grid-detail",
      "sections": [
        {
          "id": "summary",
          "caption": "Diffサマリ",
          "type": "form",
          "dataPath": "$",
          "fields": [
            {
              "field": "resultLabel",
              "caption": "判定",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "summary",
              "caption": "差分サマリ",
              "type": "textarea",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true,
                "height": 80
              }
            },
            {
              "field": "failedCount",
              "caption": "失敗件数",
              "type": "number",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "failedCheckIds",
              "caption": "失敗Check ID",
              "type": "stringArray",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "firstFailure.check_id",
              "caption": "初回失敗Check",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "firstFailure.expected",
              "caption": "初回失敗Expected",
              "type": "textarea",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true,
                "height": 80
              }
            },
            {
              "field": "firstFailure.actual",
              "caption": "初回失敗Actual",
              "type": "textarea",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true,
                "height": 80
              }
            },
            {
              "field": "test_id",
              "caption": "Test ID",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "phase",
              "caption": "Phase",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            }
          ]
        },
        {
          "id": "checks",
          "caption": "Diff Checks",
          "type": "grid",
          "dataPath": "$.checks",
          "keyField": "check_id",
          "fields": [
            {
              "field": "pass",
              "caption": "判定",
              "type": "boolean",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 70
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "check_id",
              "caption": "Check ID",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 130
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "title",
              "caption": "タイトル",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 320
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "target",
              "caption": "Target",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 300
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "type",
              "caption": "Type",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 100
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "expected_display",
              "caption": "Expected",
              "type": "textarea",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 260
              },
              "edit": {
                "visible": true,
                "readonly": true,
                "height": 120
              }
            },
            {
              "field": "actual_display",
              "caption": "Actual",
              "type": "textarea",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 260
              },
              "edit": {
                "visible": true,
                "readonly": true,
                "height": 120
              }
            },
            {
              "field": "missing",
              "caption": "Missing",
              "type": "stringArray",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 180
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "message",
              "caption": "Message",
              "type": "textarea",
              "readonly": true,
              "grid": {
                "visible": false,
                "width": 320
              },
              "edit": {
                "visible": true,
                "readonly": true,
                "height": 100
              }
            },
            {
              "field": "relation_refs",
              "caption": "Relation refs",
              "type": "stringArray",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            }
          ]
        }
      ]
    }
  ]
}

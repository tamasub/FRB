{
  "$schema": "frb_view_def_schema_v0_9.json",
  "view_def": "qa/responsibility/responsibility_expected_actual_view_def_v0_1.json",
  "app": { "name": "FRBStudio", "version": "responsibility_expected_actual_view_def_v0_1" },
  "description": "Responsibility Expected runner が出力する Actual観測値を確認するためのViewDef。判定は持たず、observations[] の actual だけを見る。",
  "views": [
    {
      "id": "responsibility_expected_actual",
      "caption": "Responsibility Expected Actual / 責務Expected Actual",
      "layout": "header-search-grid-detail",
      "sections": [
        {
          "id": "summary",
          "caption": "Actualサマリ",
          "type": "form",
          "dataPath": "$",
          "fields": [
            { "field": "test_id", "caption": "Test ID", "type": "text", "readonly": true, "grid": { "visible": false }, "edit": { "visible": true, "readonly": true } },
            { "field": "test_area", "caption": "Test Area", "type": "text", "readonly": true, "grid": { "visible": false }, "edit": { "visible": true, "readonly": true } },
            { "field": "suite_id", "caption": "Suite ID", "type": "text", "readonly": true, "grid": { "visible": false }, "edit": { "visible": true, "readonly": true } },
            { "field": "generated_at", "caption": "Generated At", "type": "text", "readonly": true, "grid": { "visible": false }, "edit": { "visible": true, "readonly": true } },
            { "field": "source_test_patterns_file", "caption": "TestPattern File", "type": "text", "readonly": true, "grid": { "visible": false }, "edit": { "visible": true, "readonly": true } }
          ]
        },
        {
          "id": "observations",
          "caption": "Actual Observations",
          "type": "grid",
          "dataPath": "$.observations",
          "keyField": "test_pattern_id",
          "fields": [
            { "field": "test_pattern_id", "caption": "Test Pattern ID", "type": "text", "readonly": true, "grid": { "visible": true, "width": 260 }, "edit": { "visible": true, "readonly": true } },
            { "field": "responsibility_cd", "caption": "責務CD", "type": "text", "readonly": true, "grid": { "visible": true, "width": 150 }, "edit": { "visible": true, "readonly": true } },
            { "field": "title", "caption": "タイトル", "type": "text", "readonly": true, "grid": { "visible": true, "width": 340 }, "edit": { "visible": true, "readonly": true } },
            { "field": "actual_display", "caption": "Actual", "type": "textarea", "readonly": true, "grid": { "visible": true, "width": 360 }, "edit": { "visible": true, "readonly": true, "height": 160 } },
            { "field": "observed_at", "caption": "Observed At", "type": "text", "readonly": true, "grid": { "visible": true, "width": 190 }, "edit": { "visible": true, "readonly": true } },
            { "field": "source", "caption": "Source", "type": "text", "readonly": true, "grid": { "visible": true, "width": 320 }, "edit": { "visible": true, "readonly": true } }
          ]
        }
      ]
    }
  ]
}

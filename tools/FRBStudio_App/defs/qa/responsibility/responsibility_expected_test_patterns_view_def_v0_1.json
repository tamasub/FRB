            },
            {
              "field": "expected.has_bom",
              "caption": "Expected: Has BOM",
              "type": "boolean",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "expected.csv_text",
              "caption": "Expected: CSV Text",
              "type": "textarea",
              "readonly": true,
              "grid": {
                "visible": false

{
  "app": {
    "name": "No-Code JSON Studio",
    "version": "responsibility-expected-tests-viewdef-v0.1"
  },
  "views": [
    {
      "id": "responsibility_expected_tests_first_set",
      "caption": "Responsibility Expected Tests First Set / 責務単位Expectedテスト初期セット",
      "layout": {
        "detailDialog": "wide"
      },
      "markdown": {
        "enabled": true,
        "defaultMode": "review_report",
        "modes": [
          {
            "id": "review_report",
            "caption": "レビュー用Markdown出力",
            "type": "review_report",
            "fieldPolicy": "respect_markdown_export"
          },
          {
            "id": "full_dump",
            "caption": "全項目Markdown出力",
            "type": "full_dump",
            "fieldPolicy": "all"
          },
          {
            "id": "document_rebuild",
            "caption": "文書Markdown出力",
            "type": "document_rebuild",
            "fieldPolicy": "respect_markdown_export",
            "description": "現在のData/ViewDefを文書として読み直すためのMarkdownを出力する。"
          }
        ],
        "defaultFileName": "responsibility_expected_tests_first_set_report.md"
      },
      "toolbar": {
        "executeButton": {
          "visible": true,
          "caption": "表示行をMD出力",
          "action": "ExportMarkdown"
        }
      },
      "sections": [
        {
          "id": "header",
          "caption": "基本情報",
          "type": "form",
          "dataPath": "$",
          "fields": [
            {
              "field": "title",
              "caption": "タイトル",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "work_item_id",
              "caption": "Work Item",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "phase",
              "caption": "Phase",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "schema_version",
              "caption": "Schema",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "document_type",
              "caption": "Document Type",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "target_responsibilities",
              "caption": "対象責務",
              "type": "stringArray",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "policy",
              "caption": "方針",
              "type": "textarea",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true,
                "height": 90
              },
              "search": {
                "visible": false
              },
              "markdown": {
                "enabled": true,
                "allowLinks": true
              }
            }
          ]
        },
        {
          "id": "test_patterns",
          "caption": "責務Expectedテストパターン",
          "type": "grid",
          "dataPath": "$.test_patterns",
          "keyField": "test_pattern_id",
          "markdown": {
            "aiPrompt": {
              "enabled": true,
              "title": "責務Expectedテストレビュー用プロンプト",
              "targetFile": "responsibility_expected_tests_first_set_data_v0_1.json",
              "rowSource": "filtered",
              "visibleOnly": true,
              "includeGridJson": true,
              "template": [
                "以下は現在表示中の責務Expectedテストパターンです。",
                "責務境界・ExpectedDef種別・入力fixture・期待値の妥当性をレビューしてください。",
                "",
                "確認観点:",
                "- responsibility_cd と title / input / expected の対応が自然か",
                "- ExpectedDef種別が妥当か",
                "- 追加すべき小さなテストパターンがあるか",
                "- UI/DOM/studio_overlaysへ踏み込みすぎていないか",
                "",
                "TSV:"
              ]
            }
          },
          "fields": [
            {
              "field": "test_pattern_id",
              "caption": "Test Pattern ID",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 220
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "responsibility_cd",
              "caption": "責務CD",
              "type": "select",
              "options": [
                {
                  "cd": "grid_column_build",
                  "name": "Grid列生成"
                },
                {
                  "cd": "search_filter",
                  "name": "検索条件評価"
                },
                {
                  "cd": "csv_export",
                  "name": "CSV出力"
                }
              ],
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 170
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "title",
              "caption": "テスト名",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 300
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "test_level",
              "caption": "Level",
              "type": "select",
              "options": [
                "UT",
                "CT",
                "E2E"
              ],
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 80
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "expected_def_type",
              "caption": "ExpectedDef",
              "type": "select",
              "options": [
                "RuleExpectedDef",
                "StateExpectedDef",
                "ErrorExpectedDef",
                "InterfaceExpectedDef",
                "PerformanceExpectedDef",
                "VisualEvidenceExpectedDef"
              ],
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 180
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "enabled",
              "caption": "有効",
              "type": "boolean",
              "grid": {
                "visible": true,
                "width": 70
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true
              }
            },
            {
              "field": "input.view_def.fields",
              "caption": "Input: ViewDef Fields",
              "type": "objectArray",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 360,
                "display": "json"
              },
              "edit": {
                "visible": true,
                "readonly": true,
                "subGrid": {
                  "readonly": true,
                  "columns": [
                    {
                      "field": "field",
                      "caption": "field",
                      "type": "text",
                      "width": 90
                    },
                    {
                      "field": "caption",
                      "caption": "caption",
                      "type": "text",
                      "width": 110
                    },
                    {
                      "field": "type",
                      "caption": "type",
                      "type": "text",
                      "width": 90
                    },
                    {
                      "field": "grid",
                      "caption": "grid",
                      "type": "json"
                    },
                    {
                      "field": "edit",
                      "caption": "edit",
                      "type": "json"
                    }
                  ]
                }
              }
            },
            {
              "field": "input.rows",
              "caption": "Input: Rows",
              "type": "objectArray",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 320,
                "display": "json"
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "input.criteria",
              "caption": "Input: Criteria",
              "type": "objectArray",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 300,
                "display": "json"
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "input.fields",
              "caption": "Input: Fields",
              "type": "objectArray",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "input.base_fields",
              "caption": "Input: Base Fields",
              "type": "objectArray",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 300,
                "display": "json"
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "input.all_fields",
              "caption": "Input: All Fields",

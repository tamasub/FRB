{
  "schema_version": "studio_overlay_manifest_v0_1",
  "document_type": "studio_overlay_manifest",
  "overlay_id": "gpt_fx_lab",
  "title": "GPT FX Lab / JSON人間フレンドリー実験Overlay",
  "status": "active",
  "owner": "chatgpt",
  "managed_by": "chatgpt",
  "created_at": "2026-07-05",
  "updated_at": "2026-07-05",
  "purpose": "Studioくんの「JSONを人間フレンドリーにする」コンセプトを、FX M5データ + T3オーバーレイ候補で試すための勇者Overlay。",
  "core_boundary_policy": {
    "core_root": "wwwroot/",
    "overlay_root": "studio_overlays/gpt_fx_lab/",
    "rule": "gpt_fx_lab は default(Copilotくん領域)へ混ぜず、独立した勇者Overlayとして Data/ViewDef/Plugin候補を追加する。"
  },
  "namespace_policy": {
    "allowed_overlay_prefixes": [
      "gpt_fx",
      "fx_demo",
      "fx_usdjpy"
    ],
    "collision_policy": "default overlay や Core のIDを上書きしない。FXは実運用目的ではなく、JSON表示実験として扱う。"
  },
  "data_files": [
    "data/fx_usdjpy_m5_t3_data_v0_1.json"
  ],
  "view_def_files": [
    "view_defs/fx_usdjpy_t3_view_def_v0_1.json"
  ],
  "value_set_files": [],
  "search_pattern_files": [],
  "plugin_index_files": [
    "plugins/plugin_index.json"
  ],
  "notes": "v0.5: Core本体は変更せず、gpt_fx_lab Overlay Plugin内でT3クロス▲▼を非表示化。Dow判定の▲▼には89pt等のFib閾値を使わず、未来を見ないHH+HL/LL+LH連続構造マーカーを表示。横幅拡大・横スクロール対応。",
  "display_projection_policy": {
    "enabled": true,
    "scope": "gpt_fx_lab overlay only",
    "raw_data_path": "data/fx_usdjpy_m5_t3_data_v0_1.json $.bars",
    "default_grid_projection": "display_sets.grid_latest_1000",
    "default_chart_projection": "display_sets.chart_latest_1000",
    "core_change": false
  },
  "chart_viewer_policy": {
    "enabled": true,
    "scope": "gpt_fx_lab overlay only",
    "action_id": "OpenFxT3Chart",
    "data_path": "$.display_sets.chart_latest_1000",
    "series": [
      "close",
      "ma20",
      "t3_20_0_2"
    ],
    "signal": "dow_structure_decision_marker",
    "core_change": false,
    "hidden_signal": "t3_cross",
    "no_lookahead": true,
    "dow_decision_settings": {
      "method": "no_lookahead_consecutive_hh_hl_ll_lh",
      "confirmation_bars_default": 3,
      "threshold_enabled": false,
      "description": "後から確定するZigZag線ではなく、その足時点で判断できた構造変化点だけを▲▼表示する。89pt等のFib/point閾値はEntryシミュレーション用であり、Dow判定マーカー表示には使わない。"
    },
    "fibonacci_threshold_used_for_dow_marker": false,
    "scroll_support": true,
    "wide_mode_support": true
  }
}

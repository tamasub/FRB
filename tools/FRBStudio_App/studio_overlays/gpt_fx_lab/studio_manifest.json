{
  "schema_version": "studio_overlay_manifest_v0_1",
  "document_type": "studio_overlay_manifest",
  "overlay_id": "gpt_fx_lab",
  "title": "GPT FX Lab / JSON人間フレンドリー実験Overlay",
  "status": "active",
  "owner": "chatgpt",
  "managed_by": "chatgpt",
  "created_at": "2026-07-05",
  "updated_at": "2026-07-05",
  "purpose": "Studioくんの「JSONを人間フレンドリーにする」コンセプトを、FX M5データ + T3オーバーレイ候補で試すための勇者Overlay。",
  "core_boundary_policy": {
    "core_root": "wwwroot/",
    "overlay_root": "studio_overlays/gpt_fx_lab/",
    "rule": "gpt_fx_lab は default(Copilotくん領域)へ混ぜず、独立した勇者Overlayとして Data/ViewDef/Plugin候補を追加する。"
  },
  "namespace_policy": {
    "allowed_overlay_prefixes": [
      "gpt_fx",
      "fx_demo",
      "fx_usdjpy"
    ],
    "collision_policy": "default overlay や Core のIDを上書きしない。FXは実運用目的ではなく、JSON表示実験として扱う。"
  },
  "data_files": [
    "data/fx_usdjpy_m5_t3_data_v0_1.json"
  ],
  "view_def_files": [
    "view_defs/fx_usdjpy_t3_view_def_v0_1.json"
  ],
  "value_set_files": [],
  "search_pattern_files": [],
  "plugin_index_files": [
    "plugins/plugin_index.json"
  ],
  "notes": "v0.8.3: 上位足パネルにupperWarmupBarsを追加し、M5窓を変えずにH1/H4過去文脈バーを増やせるようにする。",
  "display_projection_policy": {
    "enabled": true,
    "scope": "gpt_fx_lab overlay only",
    "raw_data_path": "data/fx_usdjpy_m5_t3_data_v0_1.json $.bars",
    "default_grid_projection": "display_sets.grid_latest_1000",
    "default_chart_projection": "display_sets.chart_latest_1000",
    "core_change": false
  },
  "chart_viewer_policy": {
    "enabled": true,
    "scope": "gpt_fx_lab overlay only",
    "action_id": "OpenFxT3Chart",
    "data_path": "$.display_sets.chart_latest_1000",
    "series": [
      "close",
      "ma20",
      "t3_20_0_2",
      "bollinger_upper",
      "bollinger_lower"
    ],
    "signal": "candidate_basis_retired_circle_marker",
    "core_change": false,
    "hidden_signal": "t3_cross",
    "no_lookahead": true,
    "fibonacci_threshold_used_for_dow_marker": false,
    "scroll_support": true,
    "wide_mode_support": true,
    "removed_signal": "dow_structure_decision_arrow_marker",
    "fibonacci_threshold_used_for_dow_basis_point": false,
    "basis_point_settings": {
      "method": "no_lookahead_center_window_extreme_locked_points",
      "confirm_bars_default": 10,
      "confirm_bars_user_editable": true,
      "threshold_enabled": false,
      "locked_point_policy": "confirmed_points_are_never_modified_within_one_extraction_run",
      "description": "過去から現在へ一方向に走査し、直近confirm_bars本の中央付近がwindow内の一意な高値/安値であればCandidateとする。CandidateからActive basis / Retired basisを構成し、判断履歴を消さずに観測できるようにする。Highはhigh、Lowはlowで判定し、Closeは表示系列として扱う。v0.7.3では判定ロジックに触れず、High/Lowレンジ表示で点の根拠を見やすくする。",
      "confirm_bars_presets": [
        10,
        15,
        20,
        30
      ],
      "price_source_for_high": "high",
      "price_source_for_low": "low",
      "close_used_for_basis_point_extraction": false,
      "candidate_basis_retired_layers": true,
      "high_low_range_support": true,
      "trend_decision_enabled": false,
      "entry_simulation_enabled": false
    },
    "trend_decision_enabled": false,
    "entry_simulation_enabled": false,
    "high_color_family": "green",
    "low_color_family": "red",
    "price_source_for_high": "high",
    "price_source_for_low": "low",
    "close_used_for_basis_point_extraction": false,
    "confirm_bars_presets": [
      10,
      15,
      20,
      30
    ],
    "high_low_range_support": true,
    "high_low_range_default_visible": true,
    "bollinger_bands_support": true,
    "bollinger_bands_settings": {
      "period": 20,
      "deviations": 2.0,
      "shift": 0,
      "source": "close",
      "default_visible": false,
      "used_for_basis_point_extraction": false
    },
    "url_chart_state_support": true,
    "url_chart_state_params": {
      "action": "fx_chart",
      "confirmBars": "10 / 15 / 20 / 30 etc.",
      "viewMode": "basis_only / basis_history / all",
      "hlRange": "1/0",
      "bb": "1/0",
      "wide": "1/0"
    },
    "url_chart_state_copy_support": true,
    "url_chart_state_copy_params": [
      "action",
      "confirmBars",
      "viewMode",
      "hlRange",
      "bb",
      "wide",
      "upperWarmupBars"
    ],
    "fixed_maximize_button": {
      "caption": "□",
      "position": "chart modal top-right",
      "action": "toggle-wide"
    },
    "manual_hsi_lines_support": true,
    "manual_hsi_lines": {
      "default_values": "55,89,144,188",
      "default_scale": 1,
      "used_for_basis_point_extraction": false,
      "used_for_entry_decision": false,
      "purpose": "Manual anchor hypothesis visualization",
      "scale_step": 1,
      "json_default_support": true,
      "scale_input_size": {
        "width_px": 86,
        "min_height_px": 26
      },
      "scale_step_buttons": {
        "enabled": true,
        "uses_scale_step": true
      }
    },
    "confirm_bars_default": 20,
    "confirm_bars_url_param_guard": "When confirmBars is absent/blank, use JSON default instead of 3.",
    "window_navigation": {
      "enabled": true,
      "default_size": 1000,
      "min_size": 100,
      "url_params": [
        "windowStart",
        "windowSize"
      ],
      "hsi_anchor_policy": "clear_on_window_change"
    },
    "upper_timeframe_panel": {
      "enabled": true,
      "default_timeframe": "H1",
      "switchable_timeframes": [
        "H1",
        "H4"
      ],
      "default_confirm_bars": 7,
      "source": "aggregate_from_m5",
      "sync_policy": "timestamp_shared_vertical_line",
      "basis_points": "recalculate_on_upper_timeframe",
      "teacher_guard": "observation_only_no_entry_signal"
    },
    "wide_upper_panel_fix": {
      "enabled": true,
      "draw_width_policy": "visible_width",
      "reason": "left and right panels must be visible together for upper timeframe context observation",
      "teacher_guard": "layout_only_no_entry_signal"
    },
    "url_launch_fix": {
      "enabled": true,
      "copy_includes": [
        "data",
        "view",
        "action",
        "chart_state"
      ],
      "default_data": "overlay/gpt_fx_lab/data/fx_usdjpy_m5_t3_data_v0_1.json",
      "default_view": "overlay/gpt_fx_lab/view_defs/fx_usdjpy_t3_view_def_v0_1.json",
      "action_aliases": [
        "fx_chart",
        "OpenFxT3Chart",
        "OpenFxChartViewer",
        "FxT3Chart",
        "gpt_fx_lab.fx_chart"
      ],
      "fallback_for_old_urls_without_data": true,
      "teacher_guard": "url_replay_only_no_entry_signal"
    },
    "hsi_anchor_scale_label": {
      "enabled": true,
      "label": "倍率: X",
      "reason": "HSI scale is an important observation condition for future review and AI communication.",
      "teacher_guard": "layout_label_only_no_entry_signal"
    },
    "hsi_anchor_label_direction": {
      "enabled": true,
      "up_direction": "below_anchor",
      "down_direction": "above_anchor",
      "reason": "The anchor label should not hide the HSI line direction being evaluated.",
      "teacher_guard": "layout_label_only_no_entry_signal"
    },
    "chart_comment_sidecar": {
      "enabled": true,
      "file": "sidecars/fx_usdjpy_m5_t3_data_v0_1.chart_comments.json",
      "storage_policy": "sidecar_json_not_data_json",
      "ui": "comment mode + marker + tooltip/popover edit",
      "chart_state_saved": true,
      "identity_policy": "time_price_symbol_timeframe_with_x_index_hint",
      "teacher_guard": "observation_only_no_entry_signal"
    },
    "chart_comment_sidecar_save_fix": {
      "enabled": true,
      "api_path": "/api/overlays/{overlayId}/sidecars/{file}",
      "save_target": "studio_overlays/gpt_fx_lab/sidecars/*.chart_comments.json",
      "reason": "OverlayのSidecar JSONはdata/jsonではなくstudio_overlays配下へ保存する必要があるため。",
      "teacher_guard": "comment sidecar storage only; no entry signal."
    },
    "saved_hsi_annotation_sidecar": {
      "enabled": true,
      "storage": "chart_comments sidecar hsi_annotations[]",
      "right_click_current_anchor": "save_current_hsi_hypothesis",
      "right_click_saved_anchor": "delete_saved_hsi_hypothesis",
      "show_toggle": "保存HSI表示ON/OFF",
      "temporary_hsi_policy": "normal_click_replaces_current_hsi_anchor",
      "clear_policy": "hsi_clear_only_clears_temporary_hsi",
      "teacher_guard": "human_hsi_hypothesis_only_no_entry_signal"
    },
    "upper_warmup_bars": {
      "enabled": true,
      "state_key": "upperWarmupBars",
      "default": 30,
      "presets": [
        0,
        30,
        60,
        100
      ],
      "scope": "upper timeframe panel only",
      "past_only": true,
      "m5_window_unchanged": true,
      "sync_policy": "timestamp-based vertical guide; skip when outside panel range",
      "teacher_guard": "context display warmup only; no trend/entry/simulation logic added"
    }
  },
  "changelog_file": "CHANGELOG.md",
  "current_fx_chart_viewer_version": "v0.8.2-saved-hsi-annotation-sidecar",
  "sidecar_files": [
    "sidecars/fx_usdjpy_m5_t3_data_v0_1.chart_comments.json"
  ]
}

{
  "app": {
    "name": "FRB Studio / Thought Evolution Studio",
    "version": "thought-evolution-v0.1"
  },
  "views": [
    {
      "id": "thought_evolution_graph_catalog",
      "caption": "Thought Evolution Studio / Graph Catalog",
      "layout": "header-search-grid-detail",
      "sections": [
        {
          "id": "header",
          "caption": "Thought Evolution Studio v0.1",
          "type": "form",
          "dataPath": "$",
          "fields": [
            {
              "field": "title",
              "caption": "タイトル",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "overlay_id",
              "caption": "Overlay",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "updated_at",
              "caption": "更新日",
              "type": "date",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": false
              }
            }
          ]
        },
        {
          "id": "search",
          "caption": "検索",
          "type": "form",
          "dataPath": "graphs",
          "fields": [
            {
              "field": "title",
              "caption": "グラフ名",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "status",
              "caption": "状態",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            }
          ]
        },
        {
          "id": "mainGrid",
          "caption": "グラフ一覧",
          "type": "grid",
          "dataPath": "graphs",
          "fields": [
            {
              "field": "sort_order",
              "caption": "順",
              "type": "number",
              "grid": {
                "visible": true,
                "width": 55
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "graph_id",
              "caption": "Graph ID",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 190
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true
              }
            },
            {
              "field": "title",
              "caption": "タイトル",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 320
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true
              }
            },
            {
              "field": "summary",
              "caption": "概要",
              "type": "textarea",
              "grid": {
                "visible": true,
                "width": 480
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true
              }
            },
            {
              "field": "status",
              "caption": "状態",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 80
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true
              }
            },
            {
              "field": "graph_def_file",
              "caption": "GraphDef",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "graph_data_file",
              "caption": "GraphData",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "layout_state_file",
              "caption": "LayoutState",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": false
              }
            }
          ]
        }
      ],
      "toolbar": {
        "executeButton": {
          "visible": true,
          "caption": "Thought Evolution Studioを開く",
          "action": "thought_evolution.open"
        }
      }
    }
  ],
  "layout_note": "v0.1はGraphDef / GraphData / LayoutStateを分離し、Relation Approvalを含めない。選択行の3ファイルをOverlay Pluginが読み込む。"
}

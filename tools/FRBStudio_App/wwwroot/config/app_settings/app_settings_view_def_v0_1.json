{
  "schema_version": "frb_view_def_v0_9",
  "document_type": "view_def",
  "title": "FRB Studio App Settings",
  "description": "System app_settings.json を標準Editorで表示するSystem ViewDef。sectionGroupsで既存Grid/Form Sectionを外からつまみ、Settings専用Rendererを持たない。",

              "edit": {
                "visible": true,
                "readonly": false
              },
              "search": {
                "visible": true
              }
            },
            {
              "field": "data",
              "caption": "Data JSON",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 360
              },
              "edit": {
                "visible": true,
                "readonly": false
              },
              "search": {
                "visible": true
              }
            },
            {
              "field": "view_def",
              "caption": "ViewDef",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 360
              },

{
  "app": {
    "name": "No-Code JSON Studio",
    "version": "0.4-draft-test-pattern-chat"
  },
  "views": [
    {
      "id": "screen_state_test_patterns_main",
      "caption": "画面状態JSON テストパターン台帳 v0.2-chat",
      "layout": "header-search-grid-detail",
      "sections": [
        {
          "id": "header",
          "caption": "🧪 テストパターン台帳",
          "type": "form",
          "dataPath": "$",
          "fields": [
            {
              "field": "view_def",
              "caption": "画面定義",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "readonly": true
              }
            },
            {
              "field": "schema_version",
              "caption": "Schema",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "readonly": true
              }
            },
            {
              "field": "suiteId",
              "caption": "Suite ID",
              "type": "text",
              "readonly": false,
              "grid": {
                "visible": false
              },
              "edit": {
                "readonly": false
              }
            },
            {
              "field": "title",
              "caption": "タイトル",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "readonly": false
              }
            },
            {
              "field": "targetApp",
              "caption": "対象アプリ",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "readonly": false
              }
            },
            {
              "field": "baseUrl",
              "caption": "Base URL",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "readonly": false
              }
            },
            {
              "field": "defaultExpectedDir",
              "caption": "Expected Dir",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "readonly": false
              }
            },
            {
              "field": "defaultActualDir",
              "caption": "Actual Dir",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "readonly": false
              }
            },
            {
              "field": "defaultDiffDir",
              "caption": "Diff Dir",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "readonly": false
              }
            },
            {
              "field": "defaultExpectedViewDef",
              "caption": "Expected ViewDef",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "readonly": false
              }
            },
            {
              "field": "defaultDiffViewDef",
              "caption": "Diff ViewDef",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "readonly": false
              }
            },
            {
              "field": "memo",
              "caption": "メモ",
              "type": "textarea",
              "grid": {
                "visible": false
              },
              "edit": {
                "height": 70
              }
            }
          ]
        },
        {
          "id": "patterns",
          "caption": "テストパターン一覧",
          "type": "grid",
          "dataPath": "$.patterns",
          "keyField": "patternId",
          "fields": [
            {
              "field": "enabled",
              "caption": "有効",
              "type": "boolean",
              "grid": {
                "visible": true,
                "width": 70
              },
              "search": {
                "visible": true,
                "operator": "equals"
              },
              "defaultValue": true
            },
            {
              "field": "patternId",
              "caption": "Pattern ID",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 220
              },
              "search": {
                "visible": true,
                "operator": "contains"
              },
              "validation": {
                "required": true
              },
              "defaultValue": "screen_state_new_001"
            },
            {
              "field": "title",
              "caption": "テスト名",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 320
              },
              "search": {
                "visible": true,
                "operator": "contains"
              },
              "defaultValue": "新しい画面状態JSONテスト"
            },
            {
              "field": "category",
              "caption": "Category",
              "type": "select",
              "options": [
                "smoke",
                "regression",
                "ui",
                "manual",
                "other"
              ],
              "grid": {
                "visible": true,
                "width": 110
              },
              "search": {
                "visible": true,
                "operator": "equals"
              },
              "defaultValue": "smoke"
            },
            {
              "field": "testKind",
              "caption": "Kind",
              "type": "select",
              "options": [
                "screen_state",
                "manual_seed",
                "visual",
                "api",
                "other"
              ],
              "grid": {
                "visible": true,
                "width": 130
              },
              "search": {
                "visible": true,
                "operator": "equals"
              },
              "defaultValue": "screen_state"
            },
            {
              "field": "targetUrl",
              "caption": "URL",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 90
              },
              "search": {
                "visible": true,
                "operator": "contains"
              },
              "defaultValue": "/"
            },
            {
              "field": "expectedFile",
              "caption": "Expected JSON",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 280
              },
              "search": {
                "visible": true,
                "operator": "contains"
              },
              "defaultValue": "test_patterns/new.expected.json"
            },
            {
              "field": "status",
              "caption": "Status",
              "type": "select",
              "options": [
                "draft",
                "active",
                "paused",
                "deprecated"
              ],
              "grid": {
                "visible": true,
                "width": 100
              },
              "search": {
                "visible": true,
                "operator": "equals"
              },
              "defaultValue": "draft"
            },
            {
              "field": "priority",
              "caption": "Priority",
              "type": "select",
              "options": [
                "high",
                "normal",
                "low"
              ],
              "grid": {
                "visible": true,
                "width": 90
              },
              "search": {
                "visible": true,
                "operator": "equals"
              },
              "defaultValue": "normal"
            },
            {
              "field": "checksCount",
              "caption": "Checks",
              "type": "number",
              "grid": {
                "visible": true,
                "width": 80
              },
              "search": {
                "visible": true,
                "operator": "gte"
              },
              "edit": {
                "step": 1,
                "min": 0
              },
              "defaultValue": 0
            },
            {
              "field": "expectedViewDef",
              "caption": "Expected ViewDef",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true
              },
              "defaultValue": "screen_state_expected_view_def_v0_1.json"
            },
            {
              "field": "diffViewDef",
              "caption": "Diff ViewDef",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true
              },
              "defaultValue": "screen_state_diff_view_def_v0_2_checks.json"
            },
            {
              "field": "outputActualFile",
              "caption": "Actual出力",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true
              },
              "defaultValue": ""
            },
            {
              "field": "outputDiffFile",
              "caption": "Diff出力",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true
              },
              "defaultValue": ""
            },
            {
              "field": "tags",
              "caption": "Tags",
              "type": "stringArray",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "defaultValue": []
            },
            {
              "field": "notes",
              "caption": "メモ",
              "type": "textarea",
              "grid": {
                "visible": false
              },
              "edit": {
                "height": 100
              },
              "search": {
                "visible": true,
                "operator": "contains"
              },
              "defaultValue": ""
            },
            {
              "field": "checks",
              "caption": "チェック定義",
              "type": "objectArray",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "defaultValue": []
            },
            {
              "field": "__pattern_chat",
              "caption": "テストパターン会話",
              "type": "chat",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "messages": [
                  {
                    "role": "constraint",
                    "field": "notes",
                    "label": "パターンメモ",
                    "readonly": true,
                    "height": 90
                  },
                  {
                    "role": "user",
                    "field": "user_comment",
                    "label": "俺コメント",
                    "height": 110
                  },
                  {
                    "role": "ai",
                    "field": "ai_response",
                    "label": "AI回答",
                    "readonly": true,
                    "height": 110
                  },
                  {
                    "role": "user",
                    "field": "user_reply",
                    "label": "俺追加回答",
                    "height": 90
                  },
                  {
                    "role": "ai",
                    "field": "ai_followup_response",
                    "label": "AI再回答",
                    "readonly": true,
                    "height": 110
                  }
                ],
                "input": {
                  "enabled": true,
                  "placeholder": "このテストパターンへのコメントを追加...",
                  "userField": "user_reply",
                  "aiField": "ai_followup_response",
                  "sendLabel": "送信"
                }
              },
              "search": {
                "visible": false
              },
              "create": {
                "include": false
              },
              "chat_layout_note": "俺コメント側には確認状態のラジオを埋め込まない。確認状態は詳細末尾の my_confirm_status に独立表示する。"
            },
            {
              "field": "user_comment",
              "caption": "俺コメント",
              "type": "textarea",
              "grid": {
                "visible": false,
                "width": 260
              },
              "edit": {
                "visible": false,
                "height": 110
              },
              "search": {
                "visible": true,
                "operator": "contains"
              },
              "defaultValue": ""
            },
            {
              "field": "ai_response",
              "caption": "AI回答",
              "type": "textarea",
              "readonly": true,
              "grid": {
                "visible": false,
                "width": 300
              },
              "edit": {
                "visible": false,
                "readonly": true,
                "height": 120
              },
              "search": {
                "visible": true,
                "operator": "contains"
              },
              "defaultValue": ""
            },
            {
              "field": "user_reply",
              "caption": "俺追加回答",
              "type": "textarea",
              "grid": {
                "visible": false,
                "width": 260
              },
              "edit": {
                "visible": false,
                "height": 100
              },
              "search": {
                "visible": true,
                "operator": "contains"
              },
              "defaultValue": ""
            },
            {
              "field": "ai_followup_response",
              "caption": "AI再回答",
              "type": "textarea",
              "readonly": true,
              "grid": {
                "visible": false,
                "width": 300
              },
              "edit": {
                "visible": false,
                "readonly": true,
                "height": 120
              },
              "search": {
                "visible": true,
                "operator": "contains"
              },
              "defaultValue": ""
            },
            {
              "field": "my_confirm_status",
              "caption": "確認状態",
              "type": "select",
              "options": [
                "未確認",
                "確認済み",
                "対象外"
              ],
              "grid": {
                "visible": true,
                "width": 110
              },
              "edit": {
                "visible": true,
                "control": "radio"
              },
              "search": {
                "visible": true,
                "operator": "equals"
              },
              "defaultValue": "未確認"
            }
          ]
        }
      ],
      "markdown": {
        "enabled": true,
        "type": "screen_state_test_patterns",
        "title": "画面状態JSON テストパターン台帳",
        "defaultFileName": "screen_state_test_patterns_export.md"
      }
    }
  ]
}

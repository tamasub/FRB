{
  "app": {
    "name": "No-Code JSON Studio",
    "version": "0.5-relation-business-sample"
  },
  "dataSources": {
    "customers": "business_customers_v0_1.json",
    "projects": "business_projects_v0_1.json",
    "tasks": "business_tasks_v0_1.json",
    "employees": "business_employees_v0_1.json",
    "relations": "business_relations_v0_1.json"
  },
  "writePolicy": {
    "mode": "singleSource",
    "primarySource": "employees",
    "virtualDataReadonly": false,
    "editableSources": [
      "employees"
    ],
    "readonlySources": [
      "customers",
      "projects",
      "tasks",
      "relations"
    ]
  },
  "virtualData": {
    "builder": "relation_axis_cards",
    "targetPath": "$.relation_axis_business_employee_cards",
    "axis": {
      "source": "employees",
      "path": "$.employees",
      "nodeType": "employee",
      "idField": "employee_id",
      "titleField": "employee_name"
    },
    "linked": {
      "source": "tasks",
      "path": "$.tasks",
      "nodeType": "task",
      "idField": "task_id",
      "titleField": "task_name"
    },
    "relation": {
      "source": "relations",
      "path": "$.relations",
      "name": "assigned_to",
      "direction": "incoming",
      "includeViaCheck": false
    },
    "diff": {
      "enabled": false
    },
    "outputs": {
      "idField": "employee_id",
      "titleField": "employee_name",
      "linkedItemsField": "related_tasks",
      "evidenceEdgesField": "evidence_edges",
      "linkedCountField": "task_count",
      "primaryCountField": "primary_count",
      "secondaryCountField": "secondary_count",
      "coverageField": "coverage"
    },
    "writeBack": {
      "enabled": true,
      "source": "employees",
      "path": "$.employees",
      "keyField": "employee_id",
      "rowKeyField": "employee_id",
      "fields": [
        "employee_name"
      ]
    }
  },
  "views": [
    {
      "id": "relation_axis_business_employee",
      "caption": "relation_axis_business_employee / 担当者軸",
      "layout": "header-search-grid-detail",
      "sections": [
        {
          "id": "header",
          "caption": "Business Relation / 基本情報",
          "type": "form",
          "dataPath": "$",
          "fields": [
            {
              "field": "title",
              "caption": "タイトル",
              "type": "text",
              "grid": {
                "visible": false,
                "width": 220
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "schema_version",
              "caption": "Schema",
              "type": "text",
              "grid": {
                "visible": false,
                "width": 120
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "document_type",
              "caption": "Document Type",
              "type": "text",
              "grid": {
                "visible": false,
                "width": 170
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "note",
              "caption": "メモ",
              "type": "textarea",
              "grid": {
                "visible": false,
                "width": 260
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            }
          ]
        },
        {
          "id": "main_grid",
          "caption": "relation_axis_business_employee / 担当者軸",
          "type": "grid",
          "dataPath": "$.relation_axis_business_employee_cards",
          "keyField": "employee_id",
          "fields": [
            {
              "field": "employee_id",
              "caption": "担当ID",
              "fieldType": "business.employee_id",
              "grid": {
                "visible": true,
                "width": 110
              },
              "edit": {
                "readonly": true
              }
            },
            {
              "field": "employee_name",
              "caption": "担当者",
              "fieldType": "business.employee_name",
              "grid": {
                "visible": true,
                "width": 160
              },
              "edit": {
                "readonly": false
              },
              "readonly": false
            },
            {
              "field": "trace_label",
              "caption": "状態",
              "fieldType": "business.trace_label",
              "grid": {
                "visible": true,
                "width": 120
              },
              "edit": {
                "readonly": true
              }
            },
            {
              "field": "task_count",
              "caption": "タスク数",
              "fieldType": "business.task_count",
              "grid": {
                "visible": true,
                "width": 90
              },
              "edit": {
                "readonly": true
              }
            },
            {
              "field": "primary_count",
              "caption": "主",
              "fieldType": "business.primary_count",
              "grid": {
                "visible": true,
                "width": 70
              },
              "edit": {
                "readonly": true
              }
            },
            {
              "field": "secondary_count",
              "caption": "補助",
              "fieldType": "business.secondary_count",
              "grid": {
                "visible": true,
                "width": 70
              },
              "edit": {
                "readonly": true
              }
            },
            {
              "field": "coverage",
              "caption": "Coverage",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 110
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "related_tasks",
              "caption": "担当タスク",
              "type": "objectArray",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "readonly": true
            },
            {
              "field": "evidence_edges",
              "caption": "証跡エッジ",
              "type": "objectArray",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "readonly": true
            }
          ]
        }
      ]
    }
  ],
  "fieldTypeSources": [
    "common_types_v0_1.json"
  ]
}
  "view_def": "qa/tests/responsibilities/responsibility_expected_test_patterns_view_def_v0_1.json",
  "title": "Responsibility Expected Tests First Set / 責務単位Expectedテスト初期セット",
  "work_item_id": "studio_work_0112",
  "phase": "v0.18.21-json-full-text-search",
  "target_responsibilities": [
    "grid_column_build",
    "search_filter",
    "csv_export"
  ],
  "policy": "v0.18.7で追加した責務Interfaceを対象に、まず小さく動くJSON駆動テストを作る。UI/DOM/VisualEvidence/studio_overlays直接テストは対象外とし、責務Interfaceの入力→出力だけを確認する。",
  "test_patterns": [
    {
      "test_pattern_id": "grid_column_build_visible_fields_basic",
      "responsibility_cd": "grid_column_build",
      "title": "grid.visible=false のfieldをGrid列から除外する",
      "test_level": "UT",
      "expected_def_type": "RuleExpectedDef",
      "enabled": true,
      "input": {
        "view_def": {
          "fields": [
            {
              "field": "id",
              "caption": "ID",
              "type": "text",
              "grid": {
                "visible": false
              }
            },
            {
              "field": "title",
              "caption": "タイトル",
              "type": "text",
              "grid": {
                "visible": true
              }
            },
            {
              "field": "score",
              "caption": "Score",
              "type": "number"
            }
          ]
        }
      },
      "expected": {
        "field_names": [
          "title zzz",
          "score"
        ]
      },
      "guarantee_ids": [
        "grid_column_build_g001",
        "grid_column_build_g002"
      ]
    },
    {
      "test_pattern_id": "grid_column_build_empty_fields_safe",
      "responsibility_cd": "grid_column_build",
      "title": "fields未指定でも空配列を返し落ちない",
      "test_level": "UT",
      "expected_def_type": "ErrorExpectedDef",
      "enabled": true,
      "input": {
        "view_def": {}
      },
      "expected": {
        "field_names": []
      },
      "guarantee_ids": [
        "grid_column_build_g003"
      ]
    },
    {
      "test_pattern_id": "search_filter_contains_case_insensitive",
      "responsibility_cd": "search_filter",
      "title": "文字列contains検索は大文字小文字を無視して絞り込む",
      "test_level": "UT",
      "expected_def_type": "StateExpectedDef",
      "enabled": true,
      "input": {
        "rows": [
          {
            "id": "a",
            "title": "Alpha",
            "score": 3
          },
          {
            "id": "b",
            "title": "Beta",
            "score": 10
          },
          {
            "id": "c",
            "title": "Gamma",
            "score": 7
          }
        ],
        "criteria": [
          {
            "field": "title",
            "raw": "GA",
            "type": "text",
            "operator": "contains"
          }
        ]
      },
      "expected": {
        "row_ids": [
          "c"
        ],
        "indexes": [
          2
        ]
      },
      "guarantee_ids": [
        "search_filter_g001",
        "search_filter_g002",
        "search_filter_g003"
      ]
    },
    {
      "test_pattern_id": "search_filter_number_gte_preserves_indexes",
      "responsibility_cd": "search_filter",
      "title": "数値gte検索で条件一致行だけを返し元indexを保持する",
      "test_level": "UT",
      "expected_def_type": "StateExpectedDef",
      "enabled": true,
      "input": {
        "rows": [
          {
            "id": "a",
            "title": "Alpha",
            "score": 3
          },
          {
            "id": "b",
            "title": "Beta",
            "score": 10
          },
          {
            "id": "c",
            "title": "Gamma",
            "score": 7
          }
        ],
        "criteria": [
          {
            "field": "score",
            "raw": "7",
            "type": "number",
            "operator": "gte"
          }
        ]
      },
      "expected": {
        "row_ids": [
          "b",
          "c"
        ],
        "indexes": [
          1,
          2
        ]
      },
      "guarantee_ids": [
        "search_filter_g001",
        "search_filter_g003",
        "search_filter_g004"
      ]
    },
    {
      "test_pattern_id": "search_filter_full_text_nested_strings_only",
      "responsibility_cd": "search_filter",
      "title": "全文検索はJSON全階層の文字列値を再帰検索し親行を返す",
      "test_level": "UT",
      "expected_def_type": "StateExpectedDef",
      "enabled": true,
      "input": {
        "rows": [
          {
            "id": "a",
            "title": "Alpha",
            "detail": {
              "memo": "top only"
            },
            "score": 123
          },
          {
            "id": "b",
            "title": "Beta",
            "detail": {
              "children": [
                {
                  "memo": "Needle in child grid"
                }
              ]
            }
          },
          {
            "id": "c",
            "title": "Gamma",
            "needle_key": {
              "count": 123
            }
          }
        ],
        "criteria": [],
        "options": {
          "fullText": "needle in child"
        }
      },
      "expected": {
        "row_ids": [
          "b"
        ],
        "indexes": [
          1
        ]
      },
      "guarantee_ids": [
        "search_filter_g001",
        "search_filter_g003",
        "search_filter_g007",
        "search_filter_g008"
      ]
    },
    {
      "test_pattern_id": "search_filter_full_text_excludes_keys_and_numbers",
      "responsibility_cd": "search_filter",
      "title": "全文検索はキー名と数値を検索対象へ含めない",
      "test_level": "UT",
      "expected_def_type": "StateExpectedDef",
      "enabled": true,
      "input": {
        "rows": [
          {
            "id": "a",
            "title": "Alpha",
            "123": true,
            "score": 123
          },
          {
            "id": "b",
            "title": "Beta",
            "detail": {
              "enabled": true
            }
          }
        ],
        "criteria": [],
        "options": {
          "fullText": "123"
        }
      },
      "expected": {
        "row_ids": [],
        "indexes": []
      },
      "guarantee_ids": [
        "search_filter_g001",
        "search_filter_g008"
      ]
    },
    {
      "test_pattern_id": "csv_export_visible_fields_with_key_and_escape",
      "responsibility_cd": "csv_export",
      "title": "表示列にkey列を追加し、カンマとダブルクォートをCSV escapeする",
      "test_level": "UT",
      "expected_def_type": "CsvExpectedDef",
      "enabled": true,
      "input": {
        "resolve_fields": true,
        "key_field_name": "id",
        "base_fields": [
          {
            "field": "title",
            "caption": "title",
            "type": "text"
          },
          {
            "field": "score",
            "caption": "score",
            "type": "number"
          }
        ],
        "all_fields": [
          {
            "field": "id",
            "caption": "id",
            "type": "text"
          },
          {
            "field": "title",
            "caption": "title",
            "type": "text"
          },
          {
            "field": "score",
            "caption": "score",
            "type": "number"
          }
        ],
        "rows": [
          {
            "row": {
              "id": "a",
              "title": "A, quote \"here\"",
              "score": 3
            },
            "index": 0
          }
        ]
      },
      "expected": {
        "field_names": [
          "id",
          "title",
          "score"
        ],
        "has_bom": false,
        "csv_text": "id,title,score\r\na,\"A, quote \"\"here\"\"\",3\r\n"
      },
      "guarantee_ids": [
        "csv_export_g001",
        "csv_export_g003",
        "csv_export_g004",
        "csv_export_g006"
      ]
    },
    {
      "test_pattern_id": "csv_export_utf8_bom_option",
      "responsibility_cd": "csv_export",
      "title": "includeBom=true の場合はUTF-8 BOM付きCSV文字列を返す",
      "test_level": "UT",
      "expected_def_type": "CsvExpectedDef",
      "enabled": true,
      "input": {
        "fields": [
          {
            "field": "id",
            "caption": "id",
            "type": "text"
          }
        ],
        "rows": [
          {
            "row": {
              "id": "a"
            },
            "index": 0
          }
        ],
        "include_bom": true
      },
      "expected": {
        "has_bom": true,
        "csv_without_bom": "id\r\na\r\n"
      },
      "guarantee_ids": [
        "csv_export_g005",
        "csv_export_g006"
      ]
    }
  ],
  "responsibility_relation_policy": "responsibility_cd は responsibility_data_v0_1.json の responsibilities[].responsibility_cd を参照し、guarantee_ids は同一責務の responsibilities[].guarantees[].guarantee_id を参照する。TestPatternは、自らが検証する責務と検証可能な保証をこの2項目で明示する。"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "studio_work_incident_item_schema_v0_1.json",
  "title": "FRB Studio Work Incident - New Item Input Schema v0.1",
  "description": "FRB Studioの新規インシデント1件をPasteJSON等へ渡すための入力契約。歴史データ全体の完全互換Schemaではなく、新規登録時の構造崩れ防止を目的とする。特に context_refs / follow_up_actions / discussion_history / decision_log / change_history は配列内要素をオブジェクトとして保持する。",
  "type": "object",
  "required": [
    "work_item_id",
    "phase",
    "title",
    "incident_type",
    "category",
    "priority",
    "status",
    "follow_up_status",
    "verification_status",
    "context_def_status",
    "context_def_updated_at",
    "owner",
    "ai_owner",
    "created_at",
    "updated_at",
    "target_files",
    "actual_updated_files",
    "context_def_draft",
    "objective",
    "background",
    "scope",
    "out_of_scope",
    "fixed_name_policy",
    "module_policy",
    "expected_outputs",
    "risk",
    "test_points",
    "verification_log",
    "user_request",
    "ai_response",
    "latest_ai_response",
    "latest_user_comment",
    "context_refs",
    "follow_up_actions",
    "discussion_history",
    "decision_log",
    "change_history"
  ],
  "properties": {
    "work_item_id": {
      "type": "string",
      "pattern": "^studio_work_[0-9]{4}$",
      "examples": [
        "studio_work_0171"
      ]
    },
    "phase": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "incident_type": {
      "type": "string",
      "description": "ViewDefの選択肢は運用により拡張されるためSchemaでは文字列型のみ固定する。"
    },
    "category": {
      "type": "string",
      "description": "分類語彙は運用により拡張されるためSchemaでは文字列型のみ固定する。"
    },
    "priority": {
      "type": "string",
      "examples": [
        "high",
        "medium",
        "low"
      ]
    },
    "status": {
      "type": "string",
      "examples": [
        "構想",
        "未着手",
        "対応中",
        "確認中",
        "完了",
        "保留",
        "中止"
      ]
    },
    "follow_up_status": {
      "type": "string",
      "examples": [
        "UNASSESSED",
        "NOT_REQUIRED",
        "NOT_STARTED",
        "IN_PROGRESS",
        "BLOCKED",
        "COMPLETED",
        "CANCELLED"
      ]
    },
    "verification_status": {
      "type": "string",
      "examples": [
        "未確認",
        "確認済み",
        "対象外"
      ]
    },
    "context_def_status": {
      "type": "string",
      "examples": [
        "draft",
        "reviewed",
        "approved",
        "not_required"
      ]
    },
    "context_def_updated_at": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "ai_owner": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "target_files": {
      "type": "string"
    },
    "actual_updated_files": {
      "type": "string"
    },
    "context_def_draft": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "background": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "out_of_scope": {
      "type": "string"
    },
    "fixed_name_policy": {
      "type": "string"
    },
    "module_policy": {
      "type": "string"
    },
    "expected_outputs": {
      "type": "string"
    },
    "risk": {
      "type": "string"
    },
    "test_points": {
      "type": "string"
    },
    "verification_log": {
      "type": "string"
    },
    "user_request": {
      "type": "string"
    },
    "ai_response": {
      "type": "string"
    },
    "latest_ai_response": {
      "type": "string"
    },
    "latest_user_comment": {
      "type": "string"
    },
    "context_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/context_ref"
      },
      "default": []
    },
    "follow_up_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/follow_up_action"
      },
      "default": []
    },
    "discussion_history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/discussion_history_item"
      },
      "default": []
    },
    "decision_log": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision_log_item"
      },
      "default": []
    },
    "change_history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change_history_item"
      },
      "default": []
    }
  },
  "$defs": {
    "context_ref": {
      "type": "object",
      "description": "context_refsの1要素。文字列IDだけを直接入れない。PasteJSONで「オブジェクトを指定してください」を防ぐため、必ずこのObject形にする。",
      "required": [
        "context_ref_id",
        "title",
        "read_timing",
        "target_path",
        "purpose",
        "failure_policy",
        "trust_category",
        "required",
        "enabled",
        "sort_order",
        "note"
      ],
      "properties": {
        "context_ref_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "read_timing": {
          "type": "string",
          "examples": [
            "before_work",
            "before_output",
            "before_code_update",
            "before_review"
          ]
        },
        "target_path": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "failure_policy": {
          "type": "string",
          "examples": [
            "warn_and_continue",
            "stop_and_ask"
          ]
        },
        "trust_category": {
          "type": "string",
          "examples": [
            "reference",
            "canonical"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "sort_order": {
          "type": "integer"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "follow_up_action": {
      "type": "object",
      "required": [
        "action_id",
        "action_type",
        "required",
        "status",
        "related_ids",
        "note"
      ],
      "properties": {
        "action_id": {
          "type": "string"
        },
        "action_type": {
          "type": "string",
          "examples": [
            "CONSTRAINT_ADD",
            "TEST_PATTERN_ADD",
            "EXPECTED_DEFINE",
            "REGRESSION_TEST_ADD",
            "DOCUMENT_UPDATE",
            "IMPLEMENTATION_FIX",
            "INCIDENT_FORMAT_UPDATE",
            "VIEWDEF_UPDATE",
            "UI_IMPROVEMENT",
            "OTHER"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "examples": [
            "NOT_REQUIRED",
            "NOT_STARTED",
            "IN_PROGRESS",
            "BLOCKED",
            "COMPLETED",
            "CANCELLED"
          ]
        },
        "related_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "note": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "priority": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "discussion_history_item": {
      "type": "object",
      "description": "新形式と既存の簡易形式の両方を許容する。",
      "anyOf": [
        {
          "required": [
            "history_id",
            "at",
            "speaker",
            "topic",
            "message"
          ],
          "properties": {
            "history_id": {
              "type": "string"
            },
            "at": {
              "type": "string"
            },
            "speaker": {
              "type": "string"
            },
            "topic": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "date",
            "topic",
            "summary"
          ],
          "properties": {
            "date": {
              "type": "string"
            },
            "topic": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "decision_log_item": {
      "type": "object",
      "required": [
        "decision",
        "reason"
      ],
      "properties": {
        "decision_id": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "applied_axes": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "conditions": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "exceptions": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "expected_behavior": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "acceptance_criteria": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "test_pattern_seed": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "remaining_risks": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "confirmation_level": {
          "type": "string"
        },
        "axis_update_candidate": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "change_history_item": {
      "type": "object",
      "description": "ViewDef標準形と近年のcompact形を両方許容する。",
      "anyOf": [
        {
          "required": [
            "history_id",
            "at",
            "change_type",
            "before",
            "after",
            "reason"
          ],
          "properties": {
            "history_id": {
              "type": "string"
            },
            "at": {
              "type": "string"
            },
            "change_type": {
              "type": "string"
            },
            "before": {
              "type": "string"
            },
            "after": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "change_id",
            "at",
            "change",
            "detail"
          ],
          "properties": {
            "change_id": {
              "type": "string"
            },
            "at": {
              "type": "string"
            },
            "change": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "date",
            "change",
            "detail"
          ],
          "properties": {
            "date": {
              "type": "string"
            },
            "change": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            }
          }
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

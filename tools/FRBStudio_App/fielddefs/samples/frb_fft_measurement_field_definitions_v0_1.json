  "definition_policy": {
    "coverage_mode": "sparse_explicit_contracts",
    "field_identity": "canonical_field_path",
    "unlisted_field_policy": "resolve_default_validation_type_from_view_def_type",
    "validation_type_policy": "field_definitionsへ登録した項目ではvalidation_typeを必須とする。",
    "constraint_override_policy": "Validation Type標準から変更した制約だけをconstraint_overridesへ保存する。",
    "standard_restore_policy": "標準値へ戻した制約キーはconstraint_overridesから削除し、空になった場合はconstraint_overrides自体を省略できる。"
  },
  "design_notes": [
    "ViewDef側にはvalidation_typeを保持しない。",
    "ViewDef field側にitem_definition_id等の追加キーは持たず、dataPathとfieldからfield_pathを解決する。",
    "Data JSON側にはfielddefs参照を保持しない。将来ViewDefルートのitem_definition_refから参照する。",
    "Data側のtitle / created_at / updated_at / purpose / sample_notesは、疎な項目定義を示すため意図的に未登録とする。",
    "measurement_sessions[].peak_frequency_hzとacceptance_thresholds[].peak_frequency_hzは同名だが、異なるfield_pathと異なる制約を持つ。",
    "ViewDef type=dateはYYYY-MM-DDの日付のみ、type=datetimeは時刻を含む日時を表す。",
    "received_atはViewDef type=datetimeだが、タイムゾーン付き時点のためstudio.instant.iso8601を明示する。"
  ],
  "field_definition_count": 18,

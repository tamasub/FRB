{
  "name": "frb-studio-selenium-taste",
  "version": "0.1.0",
  "private": true,
  "description": "FRB Studio NativeShell / WebView2 Selenium E2E taste test",
  "scripts": {
    "check": "node --check selenium_taste.js",
    "test": "node selenium_taste.js",
    "start": "node selenium_taste.js",
    "test:legacy": "node selenium_taste.js",
    "test:responsibility:plan": "node responsibility_test_plan.js data_update_persist",
    "test:responsibility": "node selenium_taste.js --responsibility data_update_persist",
    "plan:responsibility": "node responsibility_test_plan.js data_update_persist",
    "test:responsibility:search:plan": "node responsibility_test_plan.js search_filter",
    "test:responsibility:search": "node selenium_taste.js --responsibility search_filter",
    "test:responsibility:aggregate:plan": "node responsibility_test_plan.js grid_aggregate",
    "test:responsibility:aggregate": "node selenium_taste.js --responsibility grid_aggregate",
    "test:responsibility:aggregate:internal": "node responsibility_aggregate_runner.js grid_aggregate",
    "test:responsibility:csv:plan": "node responsibility_test_plan.js csv_export",
    "test:responsibility:csv": "node selenium_taste.js --responsibility csv_export"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "selenium-webdriver": "4.47.0"
  }
}

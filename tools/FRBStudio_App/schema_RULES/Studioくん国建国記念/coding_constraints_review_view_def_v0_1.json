              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "approved_count",
              "caption": "承認済み数",
              "type": "number",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "approval_policy",
              "caption": "承認方針",

  "document_type": "validation_type_registry",
  "title": "FRB Studio Validation Type Registry",
  "target": "ViewDef項目の値契約、選択候補、標準Validation観点を管理する共通Registry正本",
  "status": "draft",
  "created_at": "2026-07-26",
  "updated_at": "2026-08-12",
  "owner": "tamasub",
  "ai_partner": "ChatGPT",
  "introduced_in": "v0.18.33-validation-type-registry-initial",
  "source_incident": {
    "incident_file": "data/json/01_main/_studio_work_incident_data_v2.json",
    "phase": "v0.18.33-validation-type-registry-initial",
    "work_item_id": "studio_work_0149"
  },
  "purpose": "ViewDef typeとValidation Typeの許可関係、未登録項目の既定Validation契約、標準Constraints、標準TestPattern条件を一元管理する。dateとdatetimeは意味を分離する。",
  "contract": {
    "validation_type_ref_format": "{namespace}.{value_family}.{contract}",
    "catalog_role": "view_def_type_catalogsは、項目定義UIのコンボボックス候補生成、ViewDef読込時チェック、保存前チェックに使用する。",
    "definition_role": "validation_type_definitionsは、選択されたValidation Typeの値契約、標準制約、上書き可能項目、標準テスト観点を解決する。",
    "combination_policy": "ViewDef field.typeに対応するcatalogのvalidation_type_idsに指定validation_typeが存在しない場合は、ViewDef定義エラーとして扱う。暗黙の型変換で補完しない。",
    "default_selectable_statuses": [
      "active"
    ],
    "draft_visibility_policy": "status=draftは名称と設計候補を予約する。通常の項目定義UIでは非表示とし、設計・検証モードでのみ候補表示できる。",
    "catalog_integrity_policy": "catalogに記載するvalidation_type_idは、validation_type_definitionsに一意に存在しなければならない。詳細定義が未参照の場合は警告候補とする。",
    "constraint_override_policy": "項目定義Overlayはoverridable_constraintsだけを変更できる。Validation Typeが持つ固有境界を緩和して名前の意味を変えてはならず、minimum/maximum等は固有境界の内側へ狭める変更だけを許可する。",
    "required_nullable_policy": "requiredとnullableは項目存在・null許可の契約であり、null以外の値契約を表すValidation Type名には含めない。",
    "coercion_policy": "文字列から数値、数値から文字列、文字列からboolean等の暗黙変換は行わない。",
    "test_pattern_policy": "standard_test_conditionsは初期の象徴テスト観点である。test_pattern_profile_refは正式TestPattern Profile作成後に設定する。",
    "standard_test_condition_catalog_policy": "standard_test_conditionsの各キーワードはstandard_test_condition_catalog_refで指定したCatalogのconditions[].condition_idを参照する。未登録キーワードを使用してはならない。"
  },

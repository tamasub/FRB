      "constraint_overrides": {
        "required": true,
        "nullable": false,
        "empty_string_allowed": false,
        "maximum_length": 120
      }
    },
    {
      "field_path": "$.launch_shortcuts[].data",
      "validation_type": "studio.string.single_line",
      "constraint_overrides": {
        "required": true,
        "nullable": false,
        "empty_string_allowed": false,
        "maximum_length": 500
      }
    },
    {
      "field_path": "$.launch_shortcuts[].view_def",
      "validation_type": "studio.string.single_line",

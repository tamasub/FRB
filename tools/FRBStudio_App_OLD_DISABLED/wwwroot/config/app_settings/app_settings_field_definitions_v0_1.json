  "definition_policy": {
    "coverage_mode": "sparse_explicit_contracts",
    "field_identity": "canonical_field_path",
    "unlisted_field_policy": "resolve_default_validation_type_from_view_def_type",
    "validation_type_policy": "Settings画面へ露出する項目だけを明示し、Validation Typeは共通Registryの契約を使用する。",
    "constraint_override_policy": "Validation Type標準から変更する制約だけをconstraint_overridesへ保存する。",
    "standard_restore_policy": "標準値へ戻した制約キーはconstraint_overridesから削除できる。"
  },
  "design_notes": [
    "System Definitionのためユーザー領域 fielddefs/ には配置せず、wwwroot/config/app_settings/ でStudio本体が所有する。",
    "Phase 3ではDefinitionを用意するところまでとし、System Field Definitionの保存時Validation接続はPhase 4の責務とする。",
    "Dataに存在することとSettings画面から変更可能であることは別。hosting/uiは現時点ではSettings Viewへ露出しない。"
  ],
  "field_definition_count": 6,
  "field_definitions": [

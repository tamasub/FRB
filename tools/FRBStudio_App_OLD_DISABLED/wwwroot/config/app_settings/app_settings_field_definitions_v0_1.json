      "field_path": "$.launch_shortcuts[].id",
      "validation_type": "studio.string.identifier",
      "constraint_overrides": {
        "required": true,
        "nullable": false,
        "empty_string_allowed": false,
        "maximum_length": 64
      }
    },
    {
      "field_path": "$.launch_shortcuts[].caption",

{
  "schema_version": "studio_plugin_manifest_v0_1",
  "id": "thought_evolution.graph_studio",
  "caption": "Thought Evolution Studio / Evolution Engine",
  "kind": "action_plugin",
  "entry": "plugin.js",
  "actions": [
    "thought_evolution.open",
    "OpenThoughtEvolutionStudio",
    "OpenThoughtGraph"
  ],
  "scope": "thought_evolution overlay only",
  "core_change": false,
  "external_library": false,
  "description": "汎用SVGグラフ、Relation Approval、Difference Radarに、Observation評価、Evolution Proposalの人間承認、元定義を上書きしない次版Snapshot生成を追加する。",
  "version": "0.4.0",
  "permissions": [
    "read_overlay_json",
    "write_overlay_sidecar",
    "read_current_data",
    "read_core_data",
    "write_core_data",
    "open_standard_editor",
    "read_analysis_profile",
    "read_difference_results",
    "write_difference_results",
    "open_dedicated_window",
    "read_evolution_profile",
    "read_evolution_observations",
    "read_evolution_proposals",
    "write_evolution_proposals",
    "read_version_snapshots",
    "write_version_snapshots",
    "generate_next_version_snapshot"
  ]
}

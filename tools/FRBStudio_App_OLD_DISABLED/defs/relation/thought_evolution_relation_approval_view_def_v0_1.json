{
  "app": {
    "name": "FRB Studio / Thought Evolution Studio",
    "version": "v0.2-relation-approval"
  },
  "views": [
    {
      "id": "thought_evolution_relation_approval",
      "caption": "Thought Evolution Studio / Relation Approval",
      "layout": {
        "detailDialog": "wide"
      },
      "sections": [
        {
          "id": "header",
          "caption": "Relation Approval Data",
          "type": "form",
          "dataPath": "$",
          "fields": [
            {
              "field": "title",
              "caption": "タイトル",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "graph_id",
              "caption": "Graph ID",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "purpose",
              "caption": "目的",
              "type": "textarea",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true,
                "height": 74
              }
            },
            {
              "field": "policy",
              "caption": "承認方針",
              "type": "textarea",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true,
                "height": 86
              }
            },
            {
              "field": "updated_at",
              "caption": "更新日時",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            }
          ]
        },
        {
          "id": "search",
          "caption": "検索",
          "type": "form",
          "dataPath": "relations",
          "fields": [
            {
              "field": "status",
              "caption": "承認状態",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": false
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "relation_type",
              "caption": "Relation Type",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": false
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "reason",
              "caption": "理由",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": false
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            }
          ]
        },
        {
          "id": "mainGrid",
          "caption": "リレーション承認一覧",
          "type": "grid",
          "dataPath": "relations",
          "keyField": "relation_id",
          "fields": [
            {
              "field": "relation_id",
              "caption": "Relation ID",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 90
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": true
              }
            },
            {
              "field": "source_node_id",
              "caption": "From",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 130
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": true
              }
            },
            {
              "field": "relation_type",
              "caption": "Relation",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 130
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true
              }
            },
            {
              "field": "target_node_id",
              "caption": "To",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 130
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": true
              }
            },
            {
              "field": "label",
              "caption": "表示名",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 220
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true
              }
            },
            {
              "field": "status",
              "caption": "承認状態",
              "type": "select",
              "options": [
                "AI_PROPOSED",
                "HUMAN_APPROVED",
                "PENDING",
                "REJECTED"
              ],
              "grid": {
                "visible": true,
                "width": 130
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "reason",
              "caption": "接続理由",
              "type": "textarea",
              "grid": {
                "visible": true,
                "width": 360
              },
              "edit": {
                "visible": true,
                "height": 100
              },
              "search": {
                "visible": true
              }
            },
            {
              "field": "evidence_refs",
              "caption": "根拠",
              "type": "stringArray",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true
              }
            },
            {
              "field": "proposed_by",
              "caption": "提案者",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 100
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "proposed_at",
              "caption": "提案日時",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "approval.decision",
              "caption": "判断",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "approval.decided_by",
              "caption": "判断者",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "approval.decided_at",
              "caption": "判断日時",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "approval.comment",
              "caption": "承認コメント",
              "type": "textarea",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "height": 74
              }
            },
            {
              "field": "change_history",
              "caption": "変更履歴",
              "type": "objectArray",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true
              }
            }
          ]
        }
      ],
      "markdown": {
        "enabled": true,
        "type": "generic_sections",
        "title": "Thought Evolution Relation Approval",
        "sections": [
          {
            "title": "Relations",
            "dataPath": "$.relations",
            "format": "table",
            "fields": [
              "relation_id",
              "source_node_id",
              "relation_type",
              "target_node_id",
              "status",
              "reason"
            ]
          }
        ]
      }
    }
  ]
}

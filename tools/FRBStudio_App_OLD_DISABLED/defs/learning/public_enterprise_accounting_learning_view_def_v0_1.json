              "grid": {
                "visible": false
              },
              "edit": {
                "visible": false
              },
              "search": {
                "visible": true,
                "operator": "contains"
              },
              "markdown": {
                "export": true
              }
            },
            {
              "field": "ai_feedback",
              "caption": "AIフィードバック",
              "type": "textarea",
              "visibleWhen": {
                "field": "answer_reveal_status",
                "equals": "公開"
              },
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": false
              },
              "search": {
                "visible": true,
                "operator": "contains"
              },
              "markdown": {
                "export": true
              }
            },
            {
              "field": "next_question",
              "caption": "次の問い",
              "type": "textarea",
              "visibleWhen": {
                "field": "answer_reveal_status",
                "equals": "公開"
              },
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": false

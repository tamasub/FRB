{
  "app": {
    "title": "Context Model Sample"
  },
  "fieldTypeSources": [
    "common/common_types_v0_1.json"
  ],
  "views": [
    {
      "id": "main",
      "caption": "主文脈 / 対象文脈サンプル",
      "layout": {
        "detailDialog": "wide"
      },
      "toolbar": {
        "executeButton": {
          "visible": true,
          "caption": "表示行をMD出力",
          "action": "ExportMarkdown"
        }
      },
      "sections": [
        {
          "id": "summary",
          "type": "form",
          "caption": "概要",
          "dataPath": "$",
          "fields": [
            {
              "field": "title",
              "caption": "タイトル",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            },
            {
              "field": "purpose",
              "caption": "目的",
              "type": "textarea",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true,
                "height": 90
              }
            },
            {
              "field": "updated_at",
              "caption": "更新日",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              }
            }
          ]
        },
        {
          "id": "targetsGrid",
          "type": "grid",
          "caption": "対象一覧 / Target Samples",
          "dataPath": "$.sample_targets",
          "fields": [
            {
              "field": "target_id",
              "caption": "対象ID",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 190
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "target_type",
              "caption": "対象種別",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 130
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "title",
              "caption": "タイトル",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 300
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "context_refs",
              "caption": "対象文脈",
              "type": "objectArray",
              "grid": {
                "visible": true,
                "width": 170,
                "format": "targetContextSummary"
              },
              "edit": {
                "visible": true
              },
              "itemFields": [
                {
                  "field": "context_ref_id",
                  "caption": "Context Ref ID",
                  "type": "text",
                  "grid": {
                    "visible": true,
                    "width": 210
                  },
                  "edit": {
                    "visible": true
                  }
                },
                {
                  "field": "title",
                  "caption": "タイトル",
                  "type": "text",
                  "grid": {
                    "visible": true,
                    "width": 260
                  },
                  "edit": {
                    "visible": true
                  }
                },
                {
                  "field": "read_timing",
                  "caption": "読みタイミング",
                  "fieldType": "context.context_read_timing",
                  "grid": {
                    "visible": true,
                    "width": 150
                  },
                  "edit": {
                    "visible": true
                  }
                },
                {
                  "field": "target_path",
                  "caption": "対象パス",
                  "type": "text",
                  "grid": {
                    "visible": true,
                    "width": 360
                  },
                  "edit": {
                    "visible": true
                  }
                },
                {
                  "field": "purpose",
                  "caption": "読む目的",
                  "type": "textarea",
                  "grid": {
                    "visible": true,
                    "width": 420
                  },
                  "edit": {
                    "visible": true,
                    "height": 90
                  }
                },
                {
                  "field": "failure_policy",
                  "caption": "失敗時方針",
                  "fieldType": "context.failure_policy",
                  "grid": {
                    "visible": true,
                    "width": 150
                  },
                  "edit": {
                    "visible": true
                  }
                },
                {
                  "field": "trust_category",
                  "caption": "信頼区分",
                  "fieldType": "context.trust_category",
                  "grid": {
                    "visible": true,
                    "width": 120
                  },
                  "edit": {
                    "visible": true
                  }
                },
                {
                  "field": "required",
                  "caption": "必須",
                  "type": "checkbox",
                  "grid": {
                    "visible": true,
                    "width": 80
                  },
                  "edit": {
                    "visible": true
                  }
                },
                {
                  "field": "enabled",
                  "caption": "有効",
                  "type": "checkbox",
                  "grid": {
                    "visible": true,
                    "width": 80
                  },
                  "edit": {
                    "visible": true
                  }
                },
                {
                  "field": "sort_order",
                  "caption": "並び順",
                  "type": "number",
                  "grid": {
                    "visible": true,
                    "width": 90
                  },
                  "edit": {
                    "visible": true
                  }
                },
                {
                  "field": "note",
                  "caption": "メモ",
                  "type": "textarea",
                  "grid": {
                    "visible": true,
                    "width": 280
                  },
                  "edit": {
                    "visible": true,
                    "height": 80
                  }
                }
              ],
              "layout": {
                "placement": "targetContextDetailTop"
              },
              "description": "対象文脈。Gridでは件数要約、Detailでは上部専用パネルで編集する。"
            },
            {
              "field": "objective",
              "caption": "目的",
              "type": "textarea",
              "grid": {
                "visible": true,
                "width": 360
              },
              "edit": {
                "visible": true,
                "height": 90
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "status",
              "caption": "状態",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 90
              },
              "edit": {
                "visible": true
              }
            },
            {
              "field": "note",
              "caption": "メモ",
              "type": "textarea",
              "grid": {
                "visible": true,
                "width": 260
              },
              "edit": {
                "visible": true,
                "height": 80
              }
            }
          ]
        }
      ]
    }
  ],
  "commonEnumSources": [
    "config/common_enums_v0_1.json"
  ],
  "context": {
    "main_context": {
      "enabled": true,
      "display_name": "主文脈",
      "data_path": "$.main_context_refs",
      "description": "Data rootの main_context_refs[] を、このViewDef / 画面全体にかかる主文脈として扱う。ViewDefは文脈の実データを持たない。",
      "id_field": "context_ref_id",
      "title_field": "title",
      "target_path_field": "target_path",
      "read_timing_field": "read_timing",
      "failure_policy_field": "failure_policy",
      "trust_category_field": "trust_category",
      "purpose_field": "purpose",
      "notes": "v0.15.5.2: 主文脈はData root main_context_refs[] をヘッダー要約+確認パネルで表示する。通常Gridとしては表示しない。"
    },
    "target_context": {
      "enabled": true,
      "display_name": "対象文脈",
      "parent_data_path": "$.sample_targets",
      "field": "context_refs",
      "data_path": "$.context_refs",
      "description": "Data明細オブジェクト内の context_refs[] を対象文脈として扱う。Detail上部で要約・展開・編集する。",
      "id_field": "context_ref_id",
      "title_field": "title",
      "target_path_field": "target_path",
      "read_timing_field": "read_timing",
      "failure_policy_field": "failure_policy",
      "trust_category_field": "trust_category",
      "purpose_field": "purpose",
      "notes": "v0.15.5.3: 対象文脈はDetail上部の専用パネルで表示・編集し、通常childAreaの末尾表示からは除外する。Gridでは件数要約を表示する。",
      "required_field": "required",
      "enabled_field": "enabled",
      "sort_order_field": "sort_order",
      "note_field": "note",
      "grid_summary": true,
      "detail_panel": {
        "enabled": true,
        "placement": "detailTop",
        "default_expanded": true,
        "editable": true,
        "summary_badges": [
          "count",
          "required",
          "stop_like"
        ]
      }
    },
    "read_contract": {
      "enabled": true,
      "contract_id": "legacy_viewdef_context_refs_sample_contract_v0_15_5",
      "description": "旧v0.15.5互換入口。ViewDefは具体的なrequired_refsを持たず、Data上の主文脈パスだけを宣言する。",
      "main_context_data_path": "$.main_context_refs",
      "default_timing": "before_load",
      "failure_policy": "stop_and_ask",
      "row_context": {
        "enabled": true,
        "data_path": "$.context_refs",
        "id_field": "context_ref_id",
        "title_field": "title",
        "target_path_field": "target_path",
        "read_timing_field": "read_timing",
        "failure_policy_field": "failure_policy",
        "trust_field": "trust_category",
        "purpose_field": "purpose"
      },
      "notes": "互換宣言のみ。主文脈の実データはData root main_context_refs[] に置く。"
    }
  }
}

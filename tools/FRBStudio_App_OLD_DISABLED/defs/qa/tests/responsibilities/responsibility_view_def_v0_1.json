{
  "app": {
    "name": "FRB Studio / JSON Object Studio",
    "version": "responsibility-view-def-v0.1"
  },
  "fieldTypeSources": [
    "common/common_types_v0_1.json"
  ],
  "currentDataDisplay": {
    "titlePath": "$.title",
    "subtitlePath": "$.phase",
    "showDataPath": true
  },
  "views": [
    {
      "id": "responsibility_master",
      "caption": "責務マスター / Responsibility",
      "layout": {
        "detailDialog": "wide"
      },
      "toolbar": {
        "executeButton": {
          "visible": true,
          "caption": "表示行をMD出力",
          "action": "ExportMarkdown"
        }
      },
      "sections": [
        {
          "id": "header",
          "caption": "基本情報 / 方針",
          "type": "form",
          "dataPath": "$",
          "fields": [
            {
              "field": "schema_version",
              "caption": "Schema",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "document_type",
              "caption": "Document Type",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "title",
              "caption": "タイトル",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": false
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "status",

              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": false
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "phase",
              "caption": "Phase",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": false
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "updated_at",
              "caption": "更新日",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": false
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "purpose",
              "caption": "目的",
              "type": "textarea",
              "grid": {
                "visible": false

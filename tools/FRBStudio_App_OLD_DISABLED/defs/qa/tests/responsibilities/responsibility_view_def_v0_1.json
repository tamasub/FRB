              "grid": {
                "visible": true,
                "width": 110
              },
              "edit": {
                "visible": true,
                "readonly": false
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "enabled",
              "caption": "有効",
              "type": "boolean",
              "grid": {
                "visible": true,
                "width": 70
              },
              "edit": {
                "visible": true,
                "readonly": false
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "summary",
              "caption": "責務概要",
              "type": "textarea",
              "grid": {
                "visible": true,
                "width": 430

        {
          "id": "responsibilities",
          "caption": "責務一覧",
          "type": "grid",
          "dataPath": "$.responsibilities",
          "keyField": "responsibility_cd",
          "markdown": {
            "aiPrompt": {
              "enabled": true,
              "title": "責務・保証レビュー用プロンプト",
              "targetFile": "responsibility_data_v0_1.json",
              "rowSource": "filtered",
              "visibleOnly": true,
              "includeGridJson": true,
              "template": [
                "以下は現在表示中のFRB Studio責務です。",
                "責務が実装方法ではなく検証可能な保証として書かれているかレビューしてください。",
                "",
                "確認観点:",
                "- summary / purpose と guarantees の対応が自然か",
                "- guarantee_id が一意でTestPatternから参照可能か",
                "- 条件からExpectedを導出できるか",
                "- クラス構成・処理順序・アルゴリズムなどHowへ踏み込みすぎていないか",
                "- 不足する保証または分割すべき責務があるか",
                "",
                "TSV:"
              ]
            }
          },
          "fields": [
            {
              "field": "responsibility_cd",
              "caption": "責務CD",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 180
              },
              "edit": {
                "visible": true,
                "readonly": false
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "name",
              "caption": "責務名",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 210
              },
              "edit": {
                "visible": true,
                "readonly": false
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "test_level",
              "caption": "Level",
              "type": "select",
              "options": [
                "UT",
                "CT",
                "UT/CT",
                "E2E"
              ],
              "grid": {
                "visible": true,
                "width": 90
              },
              "edit": {
                "visible": true,
                "readonly": false
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "approval_status",
              "caption": "承認状態",
              "type": "select",
              "options": [

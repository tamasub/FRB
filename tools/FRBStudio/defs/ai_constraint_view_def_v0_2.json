{
  "app": {
    "name": "No-Code JSON Studio",
    "version": "0.4-draft"
  },
  "views": [
    {
      "id": "ai_constraint_main",
      "caption": "AI制約設計書 Review Editor v0.2",
      "layout": "header-search-grid-detail",
      "sections": [
        {
          "id": "header",
          "caption": "制約設計書 基本情報",
          "type": "form",
          "dataPath": "$",
          "fields": [
            {
              "field": "title",
              "caption": "タイトル",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": false
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "target",
              "caption": "対象",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "readonly": true
            },
            {
              "field": "schema_version",
              "caption": "Schema Version",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "readonly": true
            },
            {
              "field": "status",
              "caption": "状態",
              "type": "select",
              "options": [
                "human_review_draft",
                "reviewing",
                "approved",
                "needs_rework"
              ],
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true
              }
            },
            {
              "field": "generated_by",
              "caption": "生成者",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "readonly": true
            }
          ]
        },
        {
          "id": "constraints",
          "caption": "制約一覧",
          "type": "grid",
          "dataPath": "$.constraints",
          "keyField": "constraint_id",
          "fields": [
            {
              "field": "no",
              "caption": "No",
              "type": "number",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 60
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "constraint_id",
              "caption": "制約ID",
              "type": "text",
              "readonly": true,
              "grid": {
                "visible": true,
                "width": 110
              },
              "edit": {
                "visible": true,
                "readonly": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "category",
              "caption": "分類",
              "type": "select",
              "options": [
                "アプリ構成",
                "画面定義",
                "パス",
                "Field",
                "Grid表示",
                "編集",
                "検索",
                "ソート",
                "行操作",
                "コピー",
                "子配列",
                "保存",
                "Drop",
                "関連",
                "Markdown出力",
                "詳細ナビ",
                "承認",
                "未実装"
              ],
              "grid": {
                "visible": true,
                "width": 120
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "priority",
              "caption": "優先度",
              "type": "select",
              "options": [
                "high",
                "medium",
                "low"
              ],
              "grid": {
                "visible": true,
                "width": 90
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "review_check",
              "caption": "承認",
              "type": "select",
              "options": [
                "未確認",
                "◎正しい",
                "△半分正しい",
                "×違う",
                "★足りない"
              ],
              "grid": {
                "visible": true,
                "width": 130
              },
              "edit": {
                "visible": true,
                "control": "listbox",
                "shortcut": "F12で反映"
              },
              "search": {
                "visible": true,
                "operator": "equals"
              },
              "defaultValue": "未確認"
            },
            {
              "field": "title",
              "caption": "制約名",
              "type": "text",
              "grid": {
                "visible": true,
                "width": 260
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "statement",
              "caption": "制約本文",
              "type": "textarea",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "height": 100
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "user_comment",
              "caption": "俺コメント",
              "type": "textarea",
              "grid": {
                "visible": true,
                "width": 280
              },
              "edit": {
                "visible": true,
                "height": 110
              },
              "search": {
                "visible": true,
                "operator": "contains"
              },
              "defaultValue": ""
            },
            {
              "field": "ai_response",
              "caption": "AI回答",
              "type": "textarea",
              "grid": {
                "visible": true,
                "width": 320
              },
              "edit": {
                "visible": true,
                "readonly": true,
                "height": 130
              },
              "readonly": true,
              "search": {
                "visible": true,
                "operator": "contains"
              },
              "defaultValue": ""
            },
            {
              "field": "evidence",
              "caption": "根拠",
              "type": "textarea",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "height": 80
              },
              "search": {
                "visible": false
              }
            },
            {
              "field": "source_type",
              "caption": "由来",
              "type": "select",
              "options": [
                "実装由来",
                "思想由来",
                "追加制約",
                "GAP"
              ],
              "grid": {
                "visible": true,
                "width": 110
              },
              "edit": {
                "visible": true,
                "control": "listbox"
              },
              "search": {
                "visible": true,
                "operator": "equals"
              }
            },
            {
              "field": "gap_type",
              "caption": "Gap",
              "type": "text",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "contains"
              }
            },
            {
              "field": "ai_note",
              "caption": "AI初期メモ",
              "type": "textarea",
              "grid": {
                "visible": false
              },
              "edit": {
                "visible": true,
                "readonly": true,
                "height": 70
              },
              "search": {
                "visible": false
              },
              "readonly": true
            },
            {
              "field": "review_status",
              "caption": "レビュー状態",
              "type": "select",
              "options": [
                "",
                "ai_answered",
                "needs_user_review",
                "closed"
              ],
              "grid": {
                "visible": true,
                "width": 120
              },
              "edit": {
                "visible": true,
                "control": "listbox"
              },
              "search": {
                "visible": true,
                "operator": "equals"
              },
              "defaultValue": ""
            },
            {
              "field": "decision",
              "caption": "判断",
              "type": "select",
              "options": [
                "",
                "採用",
                "保留",
                "却下",
                "統合",
                "別制約へ分離"
              ],
              "grid": {
                "visible": true,
                "width": 110
              },
              "edit": {
                "visible": true,
                "control": "listbox"
              },
              "search": {
                "visible": true,
                "operator": "equals"
              },
              "defaultValue": ""
            },
            {
              "field": "implemented",
              "caption": "実装済",
              "type": "boolean",
              "grid": {
                "visible": true,
                "width": 90
              },
              "edit": {
                "visible": true
              },
              "search": {
                "visible": true,
                "operator": "equals"
              },
              "defaultValue": false
            }
          ]
        }
      ]
    }
  ]
}
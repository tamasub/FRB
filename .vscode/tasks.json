{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FRB: Compile",
      "type": "shell",
      "command": "arduino-cli",
      "args": [
        "compile",
        "--fqbn",
        "esp32:esp32:esp32",
        "${workspaceFolder}/firmware/FRB"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "FRB: Upload",
      "type": "shell",
      "command": "arduino-cli",
      "args": [
        "upload",
        "-p",
        "${input:comPort}",
        "--fqbn",
        "esp32:esp32:esp32",
        "${workspaceFolder}/firmware/FRB"
      ],
      "problemMatcher": []
    },
    {
      "label": "FRB: Monitor",
      "type": "shell",
      "command": "arduino-cli",
      "args": [
        "monitor",
        "-p",
        "${input:comPort}",
        "--config",
        "baudrate=115200"
      ],
      "problemMatcher": []
    },
    {
      "label": "FRB: Upload SPIFFS",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/upload-spiffs.ps1",
        "-Port",
        "${input:comPort}",
        "-Fqbn",
        "esp32:esp32:esp32",
        "-SketchDir",
        "${workspaceFolder}/firmware/FRB",
        "-DataDir",
        "${workspaceFolder}/data"
      ],
      "problemMatcher": []
    },
    {
      "label": "FRB: Compile and Upload",
      "dependsOrder": "sequence",
      "dependsOn": [
        "FRB: Compile",
        "FRB: Upload"
      ],
      "problemMatcher": []
    },
    {
      "label": "FRB: Full Deploy",
      "dependsOrder": "sequence",
      "dependsOn": [
        "FRB: Compile",
        "FRB: Upload",
        "FRB: Upload SPIFFS"
      ],
      "problemMatcher": []
    },
    {
      "label": "FRB: Open Web UI",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "start",
        "http://192.168.4.1/"
      ],
      "problemMatcher": []
    },
    {
      "label": "FRB: Watch data and auto-upload SPIFFS",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/watch-data-and-upload.ps1",
        "-WatchDir",
        "${workspaceFolder}/data",
        "-UploadScript",
        "${workspaceFolder}/tools/upload-spiffs.ps1",
        "-Port",
        "${input:comPort}",
        "-Fqbn",
        "esp32:esp32:esp32",
        "-SketchDir",
        "${workspaceFolder}/firmware/FRB",
        "-DataDir",
        "${workspaceFolder}/data"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "MetaDiff: Export DiffToJson",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\frb_metaDiff\\Export-DiffToJson.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "comPort",
      "type": "promptString",
      "description": "ESP32 COM Port",
      "default": "COM10"
    }
  ]
}